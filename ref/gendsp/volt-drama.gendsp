            {
                "box": {
                    "code": "/**\n * ============================================================================\n * @file volt-drama.gendsp / volt-drama.maxpat\n * @title VOLT-DRAMA (High-Grit Distortion, Moog Ladder & Evolving Drone Delay)\n * @author Max Bruckert (assisted by Gemini)\n *\n * @description\n * High-grit sound destruction and recursive drone synthesizer. Combines two\n * distinct waveshaping models (polynomial warm saturation vs Tarrabia aggressive\n * diode clipping), a 24dB/oct Moog ladder filter, a 4-voice unison detune\n * stereo spreader, and a hybrid multi-tap delay feeding back into an infinite drone.\n *\n * @inlets\n *   in1 : Audio Left Input\n *   in2 : Audio Right Input\n *\n * @outlets\n *   out1 : Distorted & Delayed Audio Left\n *   out2 : Distorted & Delayed Audio Right\n *\n * @parameters\n *   drive      (0..1, def: 0.3)          : Saturation overdrive intensity\n *   shape      (0..1, def: 0.5)          : Character (0 = Poly Warm, 1 = Tarrabia Harsh)\n *   cutoff     (50..20000 Hz, def: 20000): 24dB Moog ladder filter cutoff\n *   feedback   (0..1, def: 0.4)          : Delay regeneration (high values produce infinite drones)\n *   time       (1..1000 ms, def: 250)    : Delay loop base time\n *   spread     (0..50 ms, def: 10)       : Left/Right stereo delay offset\n *   uni_mix    (0..100 %, def: 50)       : Unison \"wall of sound\" mix\n *   uni_detune (0..100 %, def: 30)       : Detuning spread of the 4 unison voices\n *   uni_width  (0..100 %, def: 100)      : Stereo panning spread of unison voices\n *   mix_global (0..100 %, def: 50)       : Global Dry / Wet blend (name=\"mix\")\n *   gainout    (-60..12 dB, def: 0)      : Master output gain\n * ============================================================================\n */\npoly_shaper(x, drive_val) {\n    m = x * drive_val;\n    b = (m * m) * 0.28;\n    return (m / (b + 1)) * 2.0; \n}\n\ntarrabia_shaper(x, drive_val) {\n    d = min(drive_val, 0.95);\n    k = (2 * d) / (1 - d);\n    return (((1 + k) * x) / (1 + (k * abs(x)))) * 0.78; \n}\n\n// --- 2. D\u00c9CLARATIONS DES PARAM\u00c8TRES ---\n\nParam drive(0.3, min=0, max=1);        \nParam shape(0.5, min=0, max=1);        \nParam feedback(0.4, min=0, max=1);     \nParam time(250, min=1, max=1000);      \nParam spread(10, min=0, max=50);       \nParam cutoff(20000, min=50, max=20000); \nParam mix_global(50, name=\"mix\", min=0, max=100); \nParam gainout(0, min=-60, max=12);      // Nouveau param\u00e8tre de gain final (dB)\n\nParam uni_mix(50, min=0, max=100);      \nParam uni_detune(30, min=0, max=100);   \nParam uni_width(100, min=0, max=100);   \n\n// --- 3. M\u00c9MOIRES ET HISTORIQUES ---\n\nHistory h_lp1_L(0), h_lp2_L(0), h_lp3_L(0), h_lp4_L(0);\nHistory h_lp1_R(0), h_lp2_R(0), h_lp3_R(0), h_lp4_R(0);\nDelay uni_d1(2400), uni_d2(2400), uni_d3(2400), uni_d4(2400);\nHistory h_ph1(0), h_ph2(0), h_ph3(0), h_ph4(0);\nDelay delayL(48000), delayR(48000);\nHistory h_env(0);                      \nHistory h_dc_L(0), h_dc_out_L(0), h_dc_R(0), h_dc_out_R(0);\n\n// ------------------------------------------------------------------------------------------\n// 4. LOGIQUE DSP\n// ------------------------------------------------------------------------------------------\n\n// A. Lissage et Pr\u00e9paration\ns_time = slide(time, 2000, 2000);\ns_spread = slide(spread, 2000, 2000);\ns_detune = slide(uni_detune, 2000, 2000);\ns_fb = slide(feedback, 3000, 3000);\n\nfb_amount = pow(s_fb, 2) * 1.15;\nghost_amt = clamp(1.0 - s_fb * 1.5, 0, 0.4); \n\nalpha = clamp(1.0 - exp((-TWOPI * cutoff) / samplerate), 0.0001, 1.0);\nd_samps = mstosamps(s_time);\nspr_samps = mstosamps(s_spread);\nwet_gain = dbtoa(-9);\nfinal_amp = dbtoa(gainout); // Conversion dB -> Amplitude\n\n// B. Lecture Multi-Tap\ntapL_main = delayL.read(d_samps);\ntapR_main = delayR.read(d_samps + spr_samps); \ntapL_ghost = delayL.read(d_samps * 0.618);\ntapR_ghost = delayR.read((d_samps + spr_samps) * 0.618);\n\ntapL_sum = mix(tapL_main, tapL_ghost, ghost_amt);\ntapR_sum = mix(tapR_main, tapR_ghost, ghost_amt);\n\n// C. Ducking & Distorsion\nh_env = mix(abs(in1 + in2) * 0.5, h_env, 0.1); \nduck_f = h_env > 0.6 ? 0.2 : 1.0;\nfinal_fb_gain = fb_amount * duck_f;\n\nprocL = in1 + tapL_sum; \nprocR = in2 + tapR_sum;\nd_val = drive * 8; \n\nsigL = mix(poly_shaper(procL, d_val), tarrabia_shaper(procL, d_val), shape);\nsigR = mix(poly_shaper(procR, d_val), tarrabia_shaper(procR, d_val), shape);\n\ncleanL = dcblock(sigL) * wet_gain;\ncleanR = dcblock(sigR) * wet_gain;\n\n// D. 24dB Moog Ladder Filter\nlp1_L = mix(h_lp1_L, cleanL, alpha); h_lp1_L = fixdenorm(lp1_L);\nlp2_L = mix(h_lp2_L, lp1_L,  alpha); h_lp2_L = fixdenorm(lp2_L);\nlp3_L = mix(h_lp3_L, lp2_L,  alpha); h_lp3_L = fixdenorm(lp3_L);\nfilt_L = mix(h_lp4_L, lp3_L, alpha); h_lp4_L = fixdenorm(filt_L);\n\nlp1_R = mix(h_lp1_R, cleanR, alpha); h_lp1_R = fixdenorm(lp1_R);\nlp2_R = mix(h_lp2_R, lp1_R,  alpha); h_lp2_R = fixdenorm(lp2_R);\nlp3_R = mix(h_lp3_R, lp2_R,  alpha); h_lp3_R = fixdenorm(lp3_R);\nfilt_R = mix(h_lp4_R, lp3_R, alpha); h_lp4_R = fixdenorm(filt_R);\n\n// E. Unison\nh_ph1 = wrap(h_ph1 + 0.13 / samplerate, 0, 1);\nh_ph2 = wrap(h_ph2 + 0.21 / samplerate, 0, 1);\nh_ph3 = wrap(h_ph3 + 0.37 / samplerate, 0, 1);\nh_ph4 = wrap(h_ph4 + 0.49 / samplerate, 0, 1);\n\nu_depth = mstosamps(s_detune * 0.2); \nu_width = uni_width / 100;\nmono_in = (filt_L + filt_R) * 0.5;\n\nuni_d1.write(mono_in); uni_d2.write(mono_in); uni_d3.write(mono_in); uni_d4.write(mono_in);\n\nv1 = uni_d1.read(mstosamps(10) + sin(h_ph1 * TWOPI) * u_depth);\nv2 = uni_d2.read(mstosamps(15) + sin(h_ph2 * TWOPI) * u_depth);\nv3 = uni_d3.read(mstosamps(12) + sin(h_ph3 * TWOPI) * u_depth);\nv4 = uni_d4.read(mstosamps(18) + sin(h_ph4 * TWOPI) * u_depth);\n\nu_L = (v1 + v2 * 0.5) + (v3 * (1 - u_width) * 0.5);\nu_R = (v4 + v3 * 0.5) + (v2 * (1 - u_width) * 0.5);\n\nwet_final_L = mix(filt_L, u_L, uni_mix / 100);\nwet_final_R = mix(filt_R, u_R, uni_mix / 100);\n\n// F. Feedback & Sortie Finale\ndelayL.write(fixdenorm(tanh(filt_L * final_fb_gain)));\ndelayR.write(fixdenorm(tanh(filt_R * final_fb_gain)));\n\nm_val = mix_global / 100;\n\n// Application du GainOut avant le Tanh pour permettre de \"pousser\" la saturation finale\nout_pre_L = tanh(mix(in1, wet_final_L, m_val) * final_amp);\nout_pre_R = tanh(mix(in2, wet_final_R, m_val) * final_amp);\n\n// G. DC Blocker Final\ndcL = out_pre_L - h_dc_L + (0.995 * h_dc_out_L);\nh_dc_L = out_pre_L; h_dc_out_L = dcL;\nout1 = dcL;\n\ndcR = out_pre_R - h_dc_R + (0.995 * h_dc_out_R);\nh_dc_R = out_pre_R; h_dc_out_R = dcR;\nout2 = dcR;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [
                        "",
                        ""
                    ],
