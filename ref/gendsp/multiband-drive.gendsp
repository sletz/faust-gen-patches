                    ],
                    "code": "/**\n * ============================================================================\n * @file multiband-drive.gendsp / multiband-drive.maxpat\n * @title MULTIBAND DRIVE (3-Band Linkwitz-Riley LR4 Crossover Distortion Engine)\n * @author Max Bruckert\n *\n * @description\n * Studio-grade 3-band distortion workstation featuring a 4th-order\n * Linkwitz-Riley (LR4 - 24 dB/octave) phase-coherent crossover splitting\n * the stereo spectrum into Low, Mid, and High frequency bands.\n *\n * Each band features:\n *   - Independent distortion topology with continuous equal-power morphing\n *     across 4 calibrated models (Tanh Overdrive, Wavefolder, Quantizer, Modulo Wrap).\n *   - Dynamic loudness energy normalization.\n *   - Dedicated drive intensity & dry/wet saturation mix.\n *   - Drastic band gain cut down to -48 dB (with -24 dB deep notch/erase) up to +12 dB.\n *\n * Finished with master makeup gain, DC-blocking, warm tanh soft-clipping,\n * and master Dry/Wet mix.\n *\n * @inlets\n *   in1 : Audio Left Input\n *   in2 : Audio Right Input\n *\n * @outlets\n *   out1 : Processed Audio Left (Dry/Wet)\n *   out2 : Processed Audio Right (Dry/Wet)\n *   out3 : Low Band Audio Monitor\n *   out4 : Mid Band Audio Monitor\n *   out5 : High Band Audio Monitor\n * ============================================================================\n */\n\n// 1. PURE DISTORTION FUNCTION (must precede all statements)\ndistort_sample(x_in, d_norm, m_pos) {\n    // Model 1: Tanh Overdrive\n    scale_d1 = 8.0 + (35.0 - 8.0) * pow(d_norm, 0.3);\n    m1 = tanh(x_in * 2.0 * scale_d1) * 0.36;\n\n    // Model 2: Wavefolder (Symmetric Buchla/Serge style)\n    lo_f = -0.7 + (-0.3 - (-0.7)) * pow(d_norm, 0.8);\n    hi_f = 0.7 + (0.3 - 0.7) * pow(d_norm, 0.8);\n    scale_f = 1.0 + (6.0 - 1.0) * pow(d_norm, 0.3);\n    x_f = x_in * 2.0 * scale_f;\n    span = max(0.001, hi_f - lo_f);\n    fold_raw = lo_f + abs(wrap(x_f - lo_f - span, 0.0, 2.0 * span) - span);\n    clamp_f = clamp(fold_raw, -1.0, 1.0);\n    fold_comp = (0.7 / max(0.1, hi_f)) * 1.9;\n    m2 = clamp_f * 0.45 * fold_comp;\n\n    // Model 3: Quantizer (Staircase Bitcrush)\n    scale_q = 5.0 + (1.05 - 5.0) * pow(d_norm, 0.3);\n    x_q = x_in * 0.6 * scale_q;\n    q_sum = (ceil(x_q) + floor(x_q + 0.5) - 0.5) / scale_q;\n    m3 = q_sum * 0.25 * 2.3;\n\n    // Model 4: Modulo Wrap\n    scale_w = 1.0 + (6.0 - 1.0) * pow(d_norm, 0.3);\n    wrap_raw = wrap(x_in * 12.0 * scale_w, -0.5, 0.5);\n    m4 = wrap_raw * 0.8 * 0.95;\n\n    // Equal-Power Morphing across the 4 topologies\n    idx = floor(m_pos);\n    fr = m_pos - idx;\n    w0 = cos(fr * HALFPI);\n    w1 = sin(fr * HALFPI);\n\n    out_s = (idx < 1.0) ? (m1 * w0 + m2 * w1) : ((idx < 2.0) ? (m2 * w0 + m3 * w1) : (m3 * w0 + m4 * w1));\n    return out_s;\n}\n\n// 2. PARAMETERS\n// Crossover frequencies (Hz)\nParam crossover1(250, min=20, max=2000);   // Low / Mid split frequency\nParam crossover2(3500, min=200, max=18000);// Mid / High split frequency\n\n// Low Band\nParam low_band_gain(0, min=-48, max=12);   // Low band level (dB)\nParam low_drive_mix(50, min=0, max=100);   // Low band drive saturation amount (%)\nParam low_model_choice(0, min=0, max=100); // Low band model (0%: Tanh, 33%: Fold, 67%: Quant, 100%: Wrap)\n\n// Mid Band\nParam mid_band_gain(0, min=-48, max=12);   // Mid band level (dB)\nParam mid_drive_mix(50, min=0, max=100);   // Mid band drive saturation amount (%)\nParam mid_model_choice(33.3, min=0, max=100);// Mid band model (default: Wavefolder)\n\n// High Band\nParam high_band_gain(0, min=-48, max=12);  // High band level (dB)\nParam high_drive_mix(50, min=0, max=100);  // High band drive saturation amount (%)\nParam high_model_choice(0, min=0, max=100);// High band model (default: Tanh)\n\n// Master\nParam gain(0, min=-24, max=12);            // Master makeup gain (dB)\nParam mix(100, min=0, max=100);            // Master Dry / Wet mix (%)\n\n// 3. FILTER STATE HISTORIES (Direct Form I LR4 cascaded biquads)\n// Stage 1 (crossover 1): Low (LP) & Rest (HP)\nHistory h_lp1_x1_L(0), h_lp1_x2_L(0), h_lp1_y1_L(0), h_lp1_y2_L(0);\nHistory h_lp1b_x1_L(0), h_lp1b_x2_L(0), h_lp1b_y1_L(0), h_lp1b_y2_L(0);\nHistory h_hp1_x1_L(0), h_hp1_x2_L(0), h_hp1_y1_L(0), h_hp1_y2_L(0);\nHistory h_hp1b_x1_L(0), h_hp1b_x2_L(0), h_hp1b_y1_L(0), h_hp1b_y2_L(0);\n\nHistory h_lp1_x1_R(0), h_lp1_x2_R(0), h_lp1_y1_R(0), h_lp1_y2_R(0);\nHistory h_lp1b_x1_R(0), h_lp1b_x2_R(0), h_lp1b_y1_R(0), h_lp1b_y2_R(0);\nHistory h_hp1_x1_R(0), h_hp1_x2_R(0), h_hp1_y1_R(0), h_hp1_y2_R(0);\nHistory h_hp1b_x1_R(0), h_hp1b_x2_R(0), h_hp1b_y1_R(0), h_hp1b_y2_R(0);\n\n// Stage 2 (crossover 2): Mid (LP) & High (HP) on Rest\nHistory h_lp2_x1_L(0), h_lp2_x2_L(0), h_lp2_y1_L(0), h_lp2_y2_L(0);\nHistory h_lp2b_x1_L(0), h_lp2b_x2_L(0), h_lp2b_y1_L(0), h_lp2b_y2_L(0);\nHistory h_hp2_x1_L(0), h_hp2_x2_L(0), h_hp2_y1_L(0), h_hp2_y2_L(0);\nHistory h_hp2b_x1_L(0), h_hp2b_x2_L(0), h_hp2b_y1_L(0), h_hp2b_y2_L(0);\n\nHistory h_lp2_x1_R(0), h_lp2_x2_R(0), h_lp2_y1_R(0), h_lp2_y2_R(0);\nHistory h_lp2b_x1_R(0), h_lp2b_x2_R(0), h_lp2b_y1_R(0), h_lp2b_y2_R(0);\nHistory h_hp2_x1_R(0), h_hp2_x2_R(0), h_hp2_y1_R(0), h_hp2_y2_R(0);\nHistory h_hp2b_x1_R(0), h_hp2b_x2_R(0), h_hp2b_y1_R(0), h_hp2b_y2_R(0);\n\n// Output DC Blockers\nHistory h_dc_x_L(0), h_dc_y_L(0);\nHistory h_dc_x_R(0), h_dc_y_R(0);\n\n// 4. CROSSOVER BIQUAD COEFFICIENT COMPUTATION\n// Enforce f1 < f2 with safety gap\nf1 = clamp(min(crossover1, crossover2 - 40.0), 20.0, samplerate * 0.45);\nf2 = clamp(max(crossover2, crossover1 + 40.0), 40.0, samplerate * 0.45);\n\n// Stage 1 Coefficients (at f1)\nw1 = TWOPI * f1 / samplerate;\ncos_w1 = cos(w1);\nsin_w1 = sin(w1);\nalpha1 = sin_w1 * 0.70710678118; // Q = 1/sqrt(2)\na0_1 = 1.0 + alpha1;\n\nb0_lp1 = ((1.0 - cos_w1) * 0.5) / a0_1;\nb1_lp1 = (1.0 - cos_w1) / a0_1;\nb2_lp1 = b0_lp1;\na1_1 = (-2.0 * cos_w1) / a0_1;\na2_1 = (1.0 - alpha1) / a0_1;\n\nb0_hp1 = ((1.0 + cos_w1) * 0.5) / a0_1;\nb1_hp1 = (-(1.0 + cos_w1)) / a0_1;\nb2_hp1 = b0_hp1;\n\n// Stage 2 Coefficients (at f2)\nw2 = TWOPI * f2 / samplerate;\ncos_w2 = cos(w2);\nsin_w2 = sin(w2);\nalpha2 = sin_w2 * 0.70710678118;\na0_2 = 1.0 + alpha2;\n\nb0_lp2 = ((1.0 - cos_w2) * 0.5) / a0_2;\nb1_lp2 = (1.0 - cos_w2) / a0_2;\nb2_lp2 = b0_lp2;\na1_2 = (-2.0 * cos_w2) / a0_2;\na2_2 = (1.0 - alpha2) / a0_2;\n\nb0_hp2 = ((1.0 + cos_w2) * 0.5) / a0_2;\nb1_hp2 = (-(1.0 + cos_w2)) / a0_2;\nb2_hp2 = b0_hp2;\n\n// 5. CROSSOVER FILTERING (LEFT CHANNEL)\n// Stage 1 LP cascade (Low band)\ny_lp1_1_L = b0_lp1 * in1 + b1_lp1 * h_lp1_x1_L + b2_lp1 * h_lp1_x2_L - a1_1 * h_lp1_y1_L - a2_1 * h_lp1_y2_L;\nh_lp1_x2_L = h_lp1_x1_L; h_lp1_x1_L = in1; h_lp1_y2_L = h_lp1_y1_L; h_lp1_y1_L = y_lp1_1_L;\n\nlow_L = b0_lp1 * y_lp1_1_L + b1_lp1 * h_lp1b_x1_L + b2_lp1 * h_lp1b_x2_L - a1_1 * h_lp1b_y1_L - a2_1 * h_lp1b_y2_L;\nh_lp1b_x2_L = h_lp1b_x1_L; h_lp1b_x1_L = y_lp1_1_L; h_lp1b_y2_L = h_lp1b_y1_L; h_lp1b_y1_L = low_L;\n\n// Stage 1 HP cascade (Rest)\ny_hp1_1_L = b0_hp1 * in1 + b1_hp1 * h_hp1_x1_L + b2_hp1 * h_hp1_x2_L - a1_1 * h_hp1_y1_L - a2_1 * h_hp1_y2_L;\nh_hp1_x2_L = h_hp1_x1_L; h_hp1_x1_L = in1; h_hp1_y2_L = h_hp1_y1_L; h_hp1_y1_L = y_hp1_1_L;\n\nrest_L = b0_hp1 * y_hp1_1_L + b1_hp1 * h_hp1b_x1_L + b2_hp1 * h_hp1b_x2_L - a1_1 * h_hp1b_y1_L - a2_1 * h_hp1b_y2_L;\nh_hp1b_x2_L = h_hp1b_x1_L; h_hp1b_x1_L = y_hp1_1_L; h_hp1b_y2_L = h_hp1b_y1_L; h_hp1b_y1_L = rest_L;\n\n// Stage 2 LP cascade on Rest (Mid band)\ny_lp2_1_L = b0_lp2 * rest_L + b1_lp2 * h_lp2_x1_L + b2_lp2 * h_lp2_x2_L - a1_2 * h_lp2_y1_L - a2_2 * h_lp2_y2_L;\nh_lp2_x2_L = h_lp2_x1_L; h_lp2_x1_L = rest_L; h_lp2_y2_L = h_lp2_y1_L; h_lp2_y1_L = y_lp2_1_L;\n\nmid_L = b0_lp2 * y_lp2_1_L + b1_lp2 * h_lp2b_x1_L + b2_lp2 * h_lp2b_x2_L - a1_2 * h_lp2b_y1_L - a2_2 * h_lp2b_y2_L;\nh_lp2b_x2_L = h_lp2b_x1_L; h_lp2b_x1_L = y_lp2_1_L; h_lp2b_y2_L = h_lp2b_y1_L; h_lp2b_y1_L = mid_L;\n\n// Stage 2 HP cascade on Rest (High band)\ny_hp2_1_L = b0_hp2 * rest_L + b1_hp2 * h_hp2_x1_L + b2_hp2 * h_hp2_x2_L - a1_2 * h_hp2_y1_L - a2_2 * h_hp2_y2_L;\nh_hp2_x2_L = h_hp2_x1_L; h_hp2_x1_L = rest_L; h_hp2_y2_L = h_hp2_y1_L; h_hp2_y1_L = y_hp2_1_L;\n\nhigh_L = b0_hp2 * y_hp2_1_L + b1_hp2 * h_hp2b_x1_L + b2_hp2 * h_hp2b_x2_L - a1_2 * h_hp2b_y1_L - a2_2 * h_hp2b_y2_L;\nh_hp2b_x2_L = h_hp2b_x1_L; h_hp2b_x1_L = y_hp2_1_L; h_hp2b_y2_L = h_hp2b_y1_L; h_hp2b_y1_L = high_L;\n\n// 6. CROSSOVER FILTERING (RIGHT CHANNEL)\n// Stage 1 LP cascade (Low band)\ny_lp1_1_R = b0_lp1 * in2 + b1_lp1 * h_lp1_x1_R + b2_lp1 * h_lp1_x2_R - a1_1 * h_lp1_y1_R - a2_1 * h_lp1_y2_R;\nh_lp1_x2_R = h_lp1_x1_R; h_lp1_x1_R = in2; h_lp1_y2_R = h_lp1_y1_R; h_lp1_y1_R = y_lp1_1_R;\n\nlow_R = b0_lp1 * y_lp1_1_R + b1_lp1 * h_lp1b_x1_R + b2_lp1 * h_lp1b_x2_R - a1_1 * h_lp1b_y1_R - a2_1 * h_lp1b_y2_R;\nh_lp1b_x2_R = h_lp1b_x1_R; h_lp1b_x1_R = y_lp1_1_R; h_lp1b_y2_R = h_lp1b_y1_R; h_lp1b_y1_R = low_R;\n\n// Stage 1 HP cascade (Rest)\ny_hp1_1_R = b0_hp1 * in2 + b1_hp1 * h_hp1_x1_R + b2_hp1 * h_hp1_x2_R - a1_1 * h_hp1_y1_R - a2_1 * h_hp1_y2_R;\nh_hp1_x2_R = h_hp1_x1_R; h_hp1_x1_R = in2; h_hp1_y2_R = h_hp1_y1_R; h_hp1_y1_R = y_hp1_1_R;\n\nrest_R = b0_hp1 * y_hp1_1_R + b1_hp1 * h_hp1b_x1_R + b2_hp1 * h_hp1b_x2_R - a1_1 * h_hp1b_y1_R - a2_1 * h_hp1b_y2_R;\nh_hp1b_x2_R = h_hp1b_x1_R; h_hp1b_x1_R = y_hp1_1_R; h_hp1b_y2_R = h_hp1b_y1_R; h_hp1b_y1_R = rest_R;\n\n// Stage 2 LP cascade on Rest (Mid band)\ny_lp2_1_R = b0_lp2 * rest_R + b1_lp2 * h_lp2_x1_R + b2_lp2 * h_lp2_x2_R - a1_2 * h_lp2_y1_R - a2_2 * h_lp2_y2_R;\nh_lp2_x2_R = h_lp2_x1_R; h_lp2_x1_R = rest_R; h_lp2_y2_R = h_lp2_y1_R; h_lp2_y1_R = y_lp2_1_R;\n\nmid_R = b0_lp2 * y_lp2_1_R + b1_lp2 * h_lp2b_x1_R + b2_lp2 * h_lp2b_x2_R - a1_2 * h_lp2b_y1_R - a2_2 * h_lp2b_y2_R;\nh_lp2b_x2_R = h_lp2b_x1_R; h_lp2b_x1_R = y_lp2_1_R; h_lp2b_y2_R = h_lp2b_y1_R; h_lp2b_y1_R = mid_R;\n\n// Stage 2 HP cascade on Rest (High band)\ny_hp2_1_R = b0_hp2 * rest_R + b1_hp2 * h_hp2_x1_R + b2_hp2 * h_hp2_x2_R - a1_2 * h_hp2_y1_R - a2_2 * h_hp2_y2_R;\nh_hp2_x2_R = h_hp2_x1_R; h_hp2_x1_R = rest_R; h_hp2_y2_R = h_hp2_y1_R; h_hp2_y1_R = y_hp2_1_R;\n\nhigh_R = b0_hp2 * y_hp2_1_R + b1_hp2 * h_hp2b_x1_R + b2_hp2 * h_hp2b_x2_R - a1_2 * h_hp2b_y1_R - a2_2 * h_hp2b_y2_R;\nh_hp2b_x2_R = h_hp2b_x1_R; h_hp2b_x1_R = y_hp2_1_R; h_hp2b_y2_R = h_hp2b_y1_R; h_hp2b_y1_R = high_R;\n\n// 7. PER-BAND DISTORTION & GAIN SCALING\n// Low Band\nm_pos_low = clamp(low_model_choice * 0.03, 0.0, 3.0);\nd_low_L = distort_sample(low_L, low_drive_mix * 0.01, m_pos_low);\nd_low_R = distort_sample(low_R, low_drive_mix * 0.01, m_pos_low);\ngain_low = (low_band_gain <= -40.0) ? 0.0 : dbtoa(low_band_gain);\nproc_low_L = mix(low_L, d_low_L, low_drive_mix * 0.01) * gain_low;\nproc_low_R = mix(low_R, d_low_R, low_drive_mix * 0.01) * gain_low;\n\n// Mid Band\nm_pos_mid = clamp(mid_model_choice * 0.03, 0.0, 3.0);\nd_mid_L = distort_sample(mid_L, mid_drive_mix * 0.01, m_pos_mid);\nd_mid_R = distort_sample(mid_R, mid_drive_mix * 0.01, m_pos_mid);\ngain_mid = (mid_band_gain <= -40.0) ? 0.0 : dbtoa(mid_band_gain);\nproc_mid_L = mix(mid_L, d_mid_L, mid_drive_mix * 0.01) * gain_mid;\nproc_mid_R = mix(mid_R, d_mid_R, mid_drive_mix * 0.01) * gain_mid;\n\n// High Band\nm_pos_high = clamp(high_model_choice * 0.03, 0.0, 3.0);\nd_high_L = distort_sample(high_L, high_drive_mix * 0.01, m_pos_high);\nd_high_R = distort_sample(high_R, high_drive_mix * 0.01, m_pos_high);\ngain_high = (high_band_gain <= -40.0) ? 0.0 : dbtoa(high_band_gain);\nproc_high_L = mix(high_L, d_high_L, high_drive_mix * 0.01) * gain_high;\nproc_high_R = mix(high_R, d_high_R, high_drive_mix * 0.01) * gain_high;\n\n// 8. MULTIBAND RECOMBINATION & OUTPUT STAGE\nsum_raw_L = proc_low_L + proc_mid_L + proc_high_L;\nsum_raw_R = proc_low_R + proc_mid_R + proc_high_R;\n\n// DC blocker\ndc_L = sum_raw_L - h_dc_x_L + 0.995 * h_dc_y_L;\nh_dc_x_L = sum_raw_L; h_dc_y_L = dc_L;\n\ndc_R = sum_raw_R - h_dc_x_R + 0.995 * h_dc_y_R;\nh_dc_x_R = sum_raw_R; h_dc_y_R = dc_R;\n\n// Warm soft limiter & makeup gain\nmake_up = dbtoa(gain);\nlim_L = tanh(dc_L * 1.05) * make_up;\nlim_R = tanh(dc_R * 1.05) * make_up;\n\n// Master Dry/Wet Mix\neff_mix = clamp(mix * 0.01, 0.0, 1.0);\nout1 = mix(in1, lim_L, eff_mix);\nout2 = mix(in2, lim_R, eff_mix);\n\n// Individual band monitor outlets (CV / Scope)\nout3 = (proc_low_L + proc_low_R) * 0.5;\nout4 = (proc_mid_L + proc_mid_R) * 0.5;\nout5 = (proc_high_L + proc_high_R) * 0.5;\n"
                }
            },
