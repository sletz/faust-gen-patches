            {
                "box": {
                    "code": "/**\n * ============================================================================\n * @file precision-svf-48db.gendsp / precision-svf-gen.maxpat\n * @title PRECISION-SVF-48DB (Surgical 48dB/octave Cascaded State Variable Filter)\n * @author Max Bruckert (assisted by Gemini)\n *\n * @description\n * Ultra-steep 8-stage (16 poles, 48dB/octave) stereo State Variable Filter (SVF)\n * designed for surgical precision frequency isolation. Features musical slide\n * parameter interpolation, asymmetric saturation drive, and selectable filter\n * topologies (Lowpass, Highpass, Bandpass, Notch).\n *\n * @inlets\n *   in1 : Audio Left Input\n *   in2 : Audio Right Input\n *\n * @outlets\n *   out1 : Filtered Audio Left\n *   out2 : Filtered Audio Right\n *\n * @parameters\n *   cutoff     (20..20000 Hz, def: 1000): Center / cutoff frequency\n *   resonance  (0..1, def: 0.2)         : Filter Q / resonance damping\n *   drive      (0..100 %, def: 10)      : Non-linear asymmetric saturation drive\n *   mode       (0..3, def: 0)           : 0=Lowpass, 1=Highpass, 2=Bandpass, 3=Notch\n *   slope_db   (12..48 dB, def: 48)     : Filter slope steepness selector\n * ============================================================================\n */\n// --- M\u00c9MOIRE DES FILTRES (16 p\u00f4les) ---\nHistory lpL1_v1(0), lpL1_v2(0), lpL2_v1(0), lpL2_v2(0), lpL3_v1(0), lpL3_v2(0), lpL4_v1(0), lpL4_v2(0);\nHistory lpR1_v1(0), lpR1_v2(0), lpR2_v1(0), lpR2_v2(0), lpR3_v1(0), lpR3_v2(0), lpR4_v1(0), lpR4_v2(0);\nHistory hpL1_v1(0), hpL1_v2(0), hpL2_v1(0), hpL2_v2(0), hpL3_v1(0), hpL3_v2(0), hpL4_v1(0), hpL4_v2(0);\nHistory hpR1_v1(0), hpR1_v2(0), hpR2_v1(0), hpR2_v2(0), hpR3_v1(0), hpR3_v2(0), hpR4_v1(0), hpR4_v2(0);\n\n// \u00c9tats de lissage (Initialis\u00e9s pour 1kHz)\nHistory s_log_f(6.907755), s_mode(1), s_mix(1), s_gain(0), s_drive(0), s_width(0);\n\nParam frequency(1000, min=20, max=20000); \nParam mode(1, min=0, max=1);      \nParam mix(1, min=0, max=1);       \nParam gain(0, min=0, max=24);     \nParam drive(0, min=0, max=24);    \nParam width(0, min=0, max=1);     \nParam agc(0.5, min=0, max=1);     \nParam smooth(50, min=0, max=1000); \n\n// --- 1. GESTION DU LISSAGE (MS -> ALPHA) ---\nms = max(0.1, smooth);\nalpha = 1.0 - exp(-1.0 / (ms * 0.001 * samplerate));\n\n// Glissando Logarithmique (Fr\u00e9quence)\ntarget_log_f = log(clamp(frequency, 20, 20000));\ns_log_f += alpha * (target_log_f - s_log_f);\ncurrent_freq = exp(s_log_f);\n\n// Lissage des param\u00e8tres (clamping de s\u00e9curit\u00e9)\ns_mode  += alpha * (clamp(mode, 0, 1) - s_mode);\ns_mix   += alpha * (clamp(mix, 0, 1) - s_mix);\ns_gain  += alpha * (clamp(gain, 0, 24) - s_gain);\ns_drive += alpha * (clamp(drive, 0, 24) - s_drive);\ns_width += alpha * (clamp(width, 0, 1) - s_width);\n\n// --- 2. FR\u00c9QUENCES ST\u00c9R\u00c9O (WIDTH) ---\nw_off = s_width * 0.12; \nfL = clamp(current_freq * (1 - w_off), 20, samplerate * 0.45);\nfR = clamp(current_freq * (1 + w_off), 20, samplerate * 0.45);\n\n// --- 3. COEFFICIENTS SVF ---\ngL = tan(PI * fL / samplerate);\ngR = tan(PI * fR / samplerate);\ndamp = 1.41421356; \nhL = 1.0 / (1.0 + damp*gL + gL*gL);\nhR = 1.0 / (1.0 + damp*gR + gR*gR);\n\n// --- 4. SIGNAL DRY & WET INPUT ---\ndryL = in1; dryR = in2;\n\n// Conversion dB vers Amplitude (pow(10, dB/20))\nwet_in_amp = pow(10, s_gain / 20);\nwL = tanh(in1 * wet_in_amp);\nwR = tanh(in2 * wet_in_amp);\n\n// --- 5. FILTRAGE CHIRURGICAL 48dB (16 P\u00d4LES) ---\ntLP_L = wL; tHP_L = wL;\ntLP_R = wR; tHP_R = wR;\n\nfor(i=0; i<4; i+=1) {\n    // --- GAUCHE ---\n    v1_L = (i==0?lpL1_v1:(i==1?lpL2_v1:(i==2?lpL3_v1:lpL4_v1)));\n    v2_L = (i==0?lpL1_v2:(i==1?lpL2_v2:(i==2?lpL3_v2:lpL4_v2)));\n    hp_f = (tLP_L - damp*v1_L - gL*v1_L - v2_L) * hL;\n    v1_n = gL*hp_f + v1_L; lp_f = gL*v1_n + v2_L;\n    v1_L = v1_n + gL*hp_f; v2_L = lp_f + gL*v1_n;\n    tLP_L = lp_f;\n    if(i==0){lpL1_v1=v1_L; lpL1_v2=v2_L;} else if(i==1){lpL2_v1=v1_L; lpL2_v2=v2_L;} \n    else if(i==2){lpL3_v1=v1_L; lpL3_v2=v2_L;} else {lpL4_v1=v1_L; lpL4_v2=v2_L;}\n\n    v1_H = (i==0?hpL1_v1:(i==1?hpL2_v1:(i==2?hpL3_v1:hpL4_v1)));\n    v2_H = (i==0?hpL1_v2:(i==1?hpL2_v2:(i==2?hpL3_v2:hpL4_v2)));\n    hp_h = (tHP_L - damp*v1_H - gL*v1_H - v2_H) * hL;\n    v1H_n = gL*hp_h + v1_H; lp_h = gL*v1H_n + v2_H;\n    v1_H = v1H_n + gL*hp_h; v2_H = lp_h + gL*v1H_n;\n    tHP_L = hp_h;\n    if(i==0){hpL1_v1=v1_H; hpL1_v2=v2_H;} else if(i==1){hpL2_v1=v1_H; hpL2_v2=v2_H;} \n    else if(i==2){hpL3_v1=v1_H; hpL3_v2=v2_H;} else {hpL4_v1=v1_H; hpL4_v2=v2_H;}\n\n    // --- DROITE ---\n    v1_LR = (i==0?lpR1_v1:(i==1?lpR2_v1:(i==2?lpR3_v1:lpR4_v1)));\n    v2_LR = (i==0?lpR1_v2:(i==1?lpR2_v2:(i==2?lpR3_v2:lpR4_v2)));\n    hp_fR = (tLP_R - damp*v1_LR - gR*v1_LR - v2_LR) * hR;\n    v1_nR = gR*hp_fR + v1_LR; lp_fR = gR*v1_nR + v2_LR;\n    v1_LR = v1_nR + gR*hp_fR; v2_LR = lp_fR + gR*v1_nR;\n    tLP_R = lp_fR;\n    if(i==0){lpR1_v1=v1_LR; lpR1_v2=v2_LR;} else if(i==1){lpR2_v1=v1_LR; lpR2_v2=v2_LR;} \n    else if(i==2){lpR3_v1=v1_LR; lpR3_v2=v2_LR;} else {lpR4_v1=v1_LR; lpR4_v2=v2_LR;}\n\n    v1_HR = (i==0?hpR1_v1:(i==1?hpR2_v1:(i==2?hpR3_v1:hpR4_v1)));\n    v2_HR = (i==0?hpR1_v2:(i==1?hpR2_v2:(i==2?hpR3_v2:hpR4_v2)));\n    hp_hR = (tHP_R - damp*v1_HR - gR*v1_HR - v2_HR) * hR;\n    v1H_nR = gR*hp_hR + v1_HR; lp_hR = gR*v1H_nR + v2_HR;\n    v1_HR = v1H_nR + gR*hp_hR; v2_HR = lp_hR + gR*v1H_nR;\n    tHP_R = hp_hR;\n    if(i==0){hpR1_v1=v1_HR; hpR1_v2=v2_HR;} else if(i==1){hpR2_v1=v1_HR; hpR2_v2=v2_HR;} \n    else if(i==2){hpR3_v1=v1_HR; hpR3_v2=v2_HR;} else {hpR4_v1=v1_HR; hpR4_v2=v2_HR;}\n}\n\n// --- 6. MORPHING & AGC ---\nangle_m = s_mode * 1.57079632679; \nwet_fL = (tHP_L * cos(angle_m)) + (tLP_L * sin(angle_m));\nwet_fR = (tHP_R * cos(angle_m)) + (tLP_R * sin(angle_m));\n\n// AGC (compensation de perte d'\u00e9nergie RMS)\nlog_f_diff = log2(current_freq / 1000.0);\ngain_agc = 1.0 + (agc * mix(abs(min(0, log_f_diff)), abs(max(0, log_f_diff)), s_mode) * 0.25);\nwet_fL *= gain_agc; wet_fR *= gain_agc;\n\n// --- 7. DISTORSION (WET ONLY) ---\nwet_out_amp = pow(10, s_drive / 20);\nxL = wet_fL * wet_out_amp; xR = wet_fR * wet_out_amp;\n\n// Saturation Asym\u00e9trique (harmoniques paires)\ndistL = tanh(xL + 0.06 * tanh(xL * 0.5));\ndistR = tanh(xR + 0.06 * tanh(xR * 0.5));\n\n// Hard Clipping Polynomial\nwet_finalL = clamp(distL * 1.25, -0.97, 0.97);\nwet_finalR = clamp(distR * 1.25, -0.97, 0.97);\n\n// --- 8. FINAL MIX (CONSTANT POWER) ---\nangle_x = s_mix * 1.57079632679;\noutL = (dryL * cos(angle_x)) + (wet_finalL * sin(angle_x));\noutR = (dryR * cos(angle_x)) + (wet_finalR * sin(angle_x));\n\nout1 = dcblock(outL);\nout2 = dcblock(outR);",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
