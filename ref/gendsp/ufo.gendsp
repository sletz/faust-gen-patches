            },
            {
                "box": {
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 1,
                    "outlettype": [
                        ""
                    ],
                    "patching_rect": [
                        20.0,
                        60.0,
                        780.0,
                        800.0
                    ],
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 11.0,
                    "code": "/**\n * ============================================================================\n * @file ufo.gendsp / ufo.maxpat\n * @title UFO (Multi-Waveform LFO with Curvature Shaping & Slew Limiter)\n * @author Max Bruckert, after Dric (LFO) & Maurizio Giri (Rampsmooth)\n *\n * @description\n * High-definition multi-waveform Low Frequency Oscillator (LFO) featuring\n * flexible phase accumulator with free-running and one-shot burst modes,\n * dual-stage exponential curvature shaping (exp1 for phase ramp, exp2 for output curve),\n * frequency multiplication (expc), and 6 classic and generative waveforms:\n *   0: Cosine\n *   1: Triangle\n *   2: Sawtooth\n *   3: Square\n *   4: Random Sample & Hold\n *   5: Random Smooth (sample & hold through sample-accurate period slew limiter)\n *\n * Output stage includes gain scaling, bipolar offset shifting, hard clipping,\n * polarity inversion, and unipolar (0..1) / bipolar (-1..1) switching.\n *\n * @inlets\n *   in1 : Frequency in Hz (0.0001 .. 1000 Hz)\n *   in2 : Trigger / Reset audio impulse (resets cycle in free or one-shot mode)\n *\n * @outlets\n *   out1 : LFO Output (bipolar -1..1 or unipolar 0..1)\n *\n * @parameters\n *   lfosel      (0..5, def: 0)         : Waveform select: 0=Cos, 1=Tri, 2=Saw, 3=Square, 4=S&H, 5=Smooth\n *   exp1        (0.05..20, def: 1)     : Phase ramp exponential curvature shaping\n *   expc        (0..8, def: 1)         : Cycle multiplier (frequency scaling)\n *   exp2        (0.05..20, def: 1)     : Output stage exponential curvature shaping\n *   oneshot     (0..1, def: 0)         : Mode: 0=Free-running LFO, 1=One-shot burst\n *   shotnumbers (0..128, def: 1)       : Number of cycles executed in one-shot mode\n *   gain        (0..10, def: 1)        : Output level scale\n *   offset      (-100..100 %, def: 0)  : Output DC offset shift percentage\n *   invert      (0..1, def: 0)         : 0=Normal polarity, 1=Inverted\n *   unipolar    (0..1, def: 0)         : 0=Bipolar [-1, 1], 1=Unipolar [0, 1]\n * ============================================================================\n */\n\n// 1. PARAMETERS\nParam lfosel(0, min=0, max=5);\nParam exp1(1, min=0.05, max=20);\nParam expc(1, min=0, max=8);\nParam exp2(1, min=0.05, max=20);\nParam oneshot(0, min=0, max=1);\nParam shotnumbers(1, min=0, max=128);\nParam gain(1, min=0, max=10);\nParam offset(0, min=-100, max=100);\nParam invert(0, min=0, max=1);\nParam unipolar(0, min=0, max=1);\n\n// 2. MEMORIES & HISTORIES\nHistory h_phase_acc(0);\nHistory h_prev_trig(0);\nHistory h_prev_ph(0);\nHistory h_sh_val(0);\n\n// Maurizio Giri's Rampsmooth Histories\nHistory h_rs_last(0);\nHistory h_rs_dir(0);\nHistory h_rs_step(0);\nHistory h_rs_inc(0);\n\n// 3. PHASE ACCUMULATOR & ONE-SHOT BURST LOGIC\nfc = clamp(in1, 0.0001, 1000.0);\n\ntrig_high = (in2 > 0.5);\nis_trig = (trig_high && !h_prev_trig);\nh_prev_trig = trig_high;\n\nif (is_trig) {\n    h_phase_acc = 0.0;\n} else {\n    h_phase_acc += fc / samplerate;\n}\n\n// In one-shot mode, phase accumulator is clamped to shotnumbers and runs downward\nraw_acc = (oneshot > 0.5) ? (0.0 - clamp(h_phase_acc, 0.0, shotnumbers)) : h_phase_acc;\nw_base = wrap(raw_acc, 0.0, 1.0);\n\n// Curvature shaping stage 1\nph_scaled = w_base * expc;\nph_curv = pow(ph_scaled, exp1);\nph = wrap(ph_curv, 0.0, 1.0);\n\n// 4. WAVEFORM GENERATORS\n// 0: Cosine\ncos_out = cos(ph * TWOPI);\n\n// 1: Triangle\ntri_out = (ph < 0.5) ? (ph * 4.0 - 1.0) : (3.0 - ph * 4.0);\n\n// 2: Sawtooth\nsaw_out = ph * 2.0 - 1.0;\n\n// 3: Square\nsq_out = (ph < 0.5) ? 1.0 : -1.0;\n\n// 4: Sample & Hold Random (triggered on upward 0.5 phase crossing)\nis_sh_cross = (ph >= 0.5 && h_prev_ph < 0.5);\nh_prev_ph = ph;\nif (is_sh_cross) {\n    h_sh_val = noise();\n}\nsh_out = h_sh_val;\n\n// 5: Random Smooth (Maurizio Giri's rampsmooth on S&H noise)\nramp_samps = max(1.0, samplerate / max(fc, 0.0001));\nrampup = ramp_samps;\nrampdown = ramp_samps;\n\nrs_out = h_rs_last;\nif (delta(sh_out) == 0 && delta(rampup) == 0 && delta(rampdown) == 0) {\n    if (h_rs_dir > 0) {\n        if (h_rs_step < rampup) {\n            rs_out += h_rs_inc;\n            h_rs_step += 1;\n        } else {\n            rs_out = sh_out;\n        }\n    } else if (h_rs_step < rampdown) {\n        rs_out += h_rs_inc;\n        h_rs_step += 1;\n    } else {\n        rs_out = sh_out;\n    }\n} else {\n    deltavar = sh_out - rs_out;\n    if (deltavar > 0) {\n        h_rs_inc = deltavar / rampup;\n        rs_out += h_rs_inc;\n        h_rs_step = 1;\n        h_rs_dir = 1;\n    } else {\n        h_rs_inc = deltavar / rampdown;\n        rs_out += h_rs_inc;\n        h_rs_step = 1;\n        h_rs_dir = -1;\n    }\n}\nh_rs_last = rs_out;\n\n// 5. WAVEFORM SELECTOR\nraw_lfo = (lfosel < 0.5) ? cos_out :\n          (lfosel < 1.5) ? tri_out :\n          (lfosel < 2.5) ? saw_out :\n          (lfosel < 3.5) ? sq_out :\n          (lfosel < 4.5) ? sh_out : rs_out;\n\n// 6. OUTPUT STAGE (CURVATURE 2, GAIN, OFFSET, INVERT, UNIPOLAR)\nu_norm = clamp(raw_lfo * 0.5 + 0.5, 0.0, 1.0);\nu_curv = pow(u_norm, exp2);\nb_curv = u_curv * 2.0 - 1.0;\n\nb_scaled = b_curv * gain - (offset * 0.01);\nb_clipped = clamp(b_scaled, -1.0, 1.0);\n\nb_inv = (invert > 0.5) ? (0.0 - b_clipped) : b_clipped;\n\nout1 = (unipolar > 0.5) ? (b_inv * 0.5 + 0.5) : b_inv;\n"
                }
            },
