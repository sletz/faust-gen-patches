                                    "text": "expr (1*samplerate)/max(in1, 0.0001)"
                                }
                            },
                            {
                                "box": {
                                    "code": "History last(0.);\nHistory dirflag(0);\nHistory stepcounter(0);\nHistory increment(0.);\n\n// rampsmooth : original code by Maurizio Giri\ninsig = in1;\nrampup = max(in2, 1);\nrampdown = max(in3, 1);\noutsig = last;\n\nif ((delta(insig) == 0) && (delta(rampup) == 0) && (delta(rampdown) == 0)) {\n    if (dirflag > 0) {\n        if (stepcounter < rampup) {\n            outsig += increment;\n            stepcounter += 1;\n        } else {\n            outsig = insig;\n        }\n    } else if (stepcounter < rampdown) {\n        outsig += increment;\n        stepcounter += 1;\n    } else {\n        outsig = insig;\n    }\n} else {\n    deltavar = insig - outsig;\n    if (deltavar > 0) {\n        increment = deltavar / rampup;\n        outsig += increment;\n        stepcounter = 1;\n        dirflag = 1;\n    } else {\n        increment = deltavar / rampdown;\n        outsig += increment;\n        stepcounter = 1;\n        dirflag = -1;\n    }\n}\n\nlast = outsig;\nout1 = outsig;",
                                    "fontface": 0,
                                    "fontname": "<Monospaced>",
