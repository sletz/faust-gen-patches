            {
                "box": {
                    "code": "/**\n * ============================================================================\n * @file aether-drift.gendsp / aether-drift.maxpat\n * @title AETHER-DRIFT (Parallel Cloud Echo & 8-Stage Allpass Reverb)\n * @author Max Bruckert (assisted by Gemini)\n *\n * @description\n * High-diffusion spatial processor featuring parallel stereo delay and reverb\n * chains. Delay line feeds into an 8-stage cascaded allpass diffusion tank\n * with sine-wave modulation, one-pole damping, and flexible Dry/Wet mixing.\n *\n * SIGNAL FLOW:\n * Input (L/R) -> Parallel Delay Lines (smooth sliding time, damping feedback)\n *             -> Delay-to-Reverb Send (del_to_rev cross-injection)\n *             -> 8-Stage Cascaded Allpass Reverb Diffuser (LFO modulated)\n *             -> Summed FX Mix & Master Output Stage\n *\n * @inlets\n *   in1 : Audio Left Input\n *   in2 : Audio Right Input\n *\n * @outlets\n *   out1 : Processed Audio Left (Dry/Wet)\n *   out2 : Processed Audio Right (Dry/Wet)\n *\n * @parameters\n *   mix        (0..100 %, def: 50)   : Global Dry / Wet balance\n *   gainout    (-60..12 dB, def: 0)  : Master output level\n *   del_vol    (-60..6 dB, def: -6)  : Delay path volume in FX mix\n *   del_time   (0..100 %, def: 40)   : Delay time (0 to 2000 ms)\n *   del_fb     (0..100 %, def: 60)   : Delay feedback amount\n *   del_damp   (0..100 %, def: 30)   : High-frequency damping in delay loop\n *   del_to_rev (0..100 %, def: 50)   : Send level from delay into reverb tank\n *   rev_vol    (-60..6 dB, def: -6)  : Reverb path volume in FX mix\n *   rev_size   (0..99 %, def: 85)    : Reverb tank size / decay\n *   rev_diff   (0..100 %, def: 85)   : Allpass diffusion coefficient\n *   rev_damp   (0..100 %, def: 40)   : High-frequency damping in reverb tank\n *   rev_mod    (0..100 %, def: 40)   : Reverb allpass modulation depth\n * ============================================================================\n */\nParam mix(50, min=0, max=100);          // Balance globale Dry / Wet total\nParam gainout(0, min=-60, max=12);      // Gain de sortie final (dB)\n\n// --- Contr\u00f4les Delay (Parall\u00e8le) ---\nParam del_vol(-6, min=-60, max=6);      // Volume du Delay dans le mix FX (dB)\nParam del_time(40, min=0, max=100);     // Temps (0-2000ms)\nParam del_fb(60, min=0, max=100);       // Feedback (%)\nParam del_damp(30, min=0, max=100);     // Damping (%)\nParam del_to_rev(50, min=0, max=100);   // Envoi du Delay vers la Reverb (%)\n\n// --- Contr\u00f4les Reverb (Parall\u00e8le) ---\nParam rev_vol(-6, min=-60, max=6);      // Volume de la Reverb dans le mix FX (dB)\nParam rev_size(85, min=0, max=99);      // Decay (%)\nParam rev_diff(85, min=0, max=100);     // Diffusion / Warp (%)\nParam rev_damp(40, min=0, max=100);     // Damping (%)\nParam rev_mod(40, min=0, max=100);      // Modulation (%)\n\n// --- M\u00e9moires Delay ---\nDelay delay_L(samplerate * 2), delay_R(samplerate * 2);\nHistory h_del_lp_L(0), h_del_lp_R(0);\n\n// --- M\u00e9moires Reverb (8 All-pass s\u00e9rie) ---\nDelay ap1(151), ap2(233), ap3(347), ap4(563);\nDelay ap5(761), ap6(997), ap7(1153), ap8(1427);\n\n// --- M\u00e9moires Reverb (Tank) ---\nDelay d1(5000), d2(6000), d3(4000), d4(6000);\nDelay apt1(707), apt2(503), apt3(769), apt4(613); \nHistory h_rev_lp1(0), h_rev_lp2(0);\nHistory h_dc_L(0), h_dc_out_L(0), h_dc_R(0), h_dc_out_R(0);\n\n// ------------------------------------------------------------------------------------------\n// 1. CHAINE PARALL\u00c8LE : DELAY\n// ------------------------------------------------------------------------------------------\ndt = slide(del_time / 100, 1000, 1000) * 2000;\nd_samps = mstosamps(dt);\n\n// Lecture\nwet_del_L = delay_L.read(d_samps);\nwet_del_R = delay_R.read(d_samps + 5);\n\n// Damping et Feedback\nh_del_lp_L = mix(wet_del_L, h_del_lp_L, del_damp / 100);\nh_del_lp_R = mix(wet_del_R, h_del_lp_R, del_damp / 100);\n\ndelay_L.write(dcblock(in1 + h_del_lp_L * (del_fb / 100)));\ndelay_R.write(dcblock(in2 + h_del_lp_R * (del_fb / 100)));\n\n// Sortie de la chaine Delay (avec son volume propre)\nsig_del_L = wet_del_L * dbtoa(del_vol);\nsig_del_R = wet_del_R * dbtoa(del_vol);\n\n// ------------------------------------------------------------------------------------------\n// 2. CHAINE PARALL\u00c8LE : REVERB\n// ------------------------------------------------------------------------------------------\n// Entr\u00e9e de la r\u00e9verbe = Signal Dry + (Signal Delay * envoi)\nrev_in = ((in1 + in2) * 0.5) + ((wet_del_L + wet_del_R) * 0.5 * (del_to_rev / 100));\n\n// Mega-Diffusion d'entr\u00e9e\ndf_in = 0.75;\nv1 = rev_in - ap1.read(151) * df_in; ap1.write(v1); i1 = ap1.read(151) + v1 * df_in;\nv2 = i1 - ap2.read(233) * df_in; ap2.write(v2); i2 = ap2.read(233) + v2 * df_in;\nv3 = i2 - ap3.read(347) * df_in; ap3.write(v3); i3 = ap3.read(347) + v3 * df_in;\nv4 = i3 - ap4.read(563) * df_in; ap4.write(v4); i4 = ap4.read(563) + v4 * df_in;\nv5 = i4 - ap5.read(761) * df_in; ap5.write(v5); i5 = ap5.read(761) + v5 * df_in;\nv6 = i5 - ap6.read(997) * df_in; ap6.write(v6); i6 = ap6.read(997) + v6 * df_in;\nv7 = i6 - ap7.read(1153) * df_in; ap7.write(v7); i7 = ap7.read(1153) + v7 * df_in;\nv8 = i7 - ap8.read(1427) * df_in; ap8.write(v8); \ndiffused_in = ap8.read(1427) + v8 * df_in;\n\n// Tank Cloud\nd_c = 0.7 * (rev_diff / 100);\ndec = rev_size / 100;\ndamp = rev_damp / 100;\nlfo1 = cycle(0.07) * (rev_mod / 5) * 30;\nlfo2 = cycle(0.11) * (rev_mod / 5) * 30;\n\ns_d2 = d2.read(4217 + lfo1);\ns_d4 = d4.read(4845 + lfo2);\nh_rev_lp1 = mix(s_d2, h_rev_lp1, damp);\nh_rev_lp2 = mix(s_d4, h_rev_lp2, damp);\n\n// Feedback Loop\nfbL = diffused_in + h_rev_lp2 * dec;\nv_at1 = fbL - apt1.read(707) * -d_c; apt1.write(v_at1); r_at1 = apt1.read(707) + v_at1 * -d_c;\nv_at2 = r_at1 - apt2.read(503) * d_c; apt2.write(v_at2); r_at2 = apt2.read(503) + v_at2 * d_c;\nd1.write(dcblock(r_at2));\n\nfbR = diffused_in + h_rev_lp1 * dec;\nv_at3 = fbR - apt3.read(769) * -d_c; apt3.write(v_at3); r_at3 = apt3.read(769) + v_at3 * -d_c;\nv_at4 = r_at3 - apt4.read(613) * d_c; apt4.write(v_at4); r_at4 = apt4.read(613) + v_at4 * d_c;\nd3.write(dcblock(r_at4));\n\nd2.write(d1.read(4453));\nd4.write(d3.read(3163));\n\n// Sortie de la chaine Reverb (avec son volume propre)\nsig_rev_L = (d1.read(4453) + r_at2 - r_at4) * dbtoa(rev_vol);\nsig_rev_R = (d3.read(3163) + r_at4 - r_at2) * dbtoa(rev_vol);\n\n// ------------------------------------------------------------------------------------------\n// 3. MIXAGE FINAL (Dry vs FX Sum)\n// ------------------------------------------------------------------------------------------\n// Somme des effets\nfx_L = sig_del_L + sig_rev_L;\nfx_R = sig_del_R + sig_rev_R;\n\n// Balance Dry/Wet globale\nmix_L = mix(in1, fx_L, mix / 100);\nmix_R = mix(in2, fx_R, mix / 100);\n\n// Gain de sortie, Limiteur et DC Block\nout_pre_L = tanh(mix_L * dbtoa(gainout));\nout_pre_R = tanh(mix_R * dbtoa(gainout));\n\ndcL = out_pre_L - h_dc_L + (0.995 * h_dc_out_L);\nh_dc_L = out_pre_L; h_dc_out_L = dcL;\nout1 = dcL;\n\ndcR = out_pre_R - h_dc_R + (0.995 * h_dc_out_R);\nh_dc_R = out_pre_R; h_dc_out_R = dcR;\nout2 = dcR;",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
                    "id": "obj-3",
                    "maxclass": "codebox",
                    "numinlets": 2,
                    "numoutlets": 2,
                    "outlettype": [
                        "",
                        ""
