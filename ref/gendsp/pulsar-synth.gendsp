                        60.0,
                        750.0,
                        650.0
                    ],
                    "code": "/**\n * ============================================================================\n * @file pulsar-synth.gendsp / pulsar-synth.maxpat\n * @title CONTINUOUS PULSAR SYNTHESIS ENGINE (Curtis Roads)\n * @author Max Bruckert (assisted by Gemini)\n *\n * @description\n * Complete generator for Curtis Roads' Pulsar Synthesis technique.\n * Generates trains of sonic particles (pulsarets) followed by silences within\n * a fundamental period T. Morphing between rhythmic clicks, granular textures,\n * and formant clouds.\n *\n * @inlets\n *   in1 : External Reset / Sync Trigger\n *   in2 : Formant Frequency Audio Modulator\n *\n * @outlets\n *   out1 : Pulsar Audio Left\n *   out2 : Pulsar Audio Right (Stereo Spatial Spread)\n * ============================================================================\n */\n\nParam f0(25, min=0.1, max=500);\nParam formant_f(650, min=20, max=8000);\nParam duty_ratio(0.3, min=0.01, max=1.0);\nParam wave_shape(0, min=0, max=3);\nParam win_type(1, min=0, max=3);\nParam masking(0, min=0, max=1);\nParam pan_spread(0.5, min=0, max=1);\n\nHistory h_phase_f0(0);\nHistory h_pulsar_active(1);\nHistory h_pulse_count(0);\nHistory h_prev_in1(0);\n\n// Rising-edge trigger detection on in1 for true hard phase sync\ntrig_sync = (in1 > 0.5) && (h_prev_in1 <= 0.5);\nh_prev_in1 = in1;\n\n// Period phasor (f0)\nf0_step = clamp(f0, 0.05, 500) / samplerate;\nnew_cycle = ((h_phase_f0 + f0_step) >= 1.0) || trig_sync;\nphase_f0 = trig_sync ? 0 : wrap(h_phase_f0 + f0_step, 0, 1);\nh_phase_f0 = phase_f0;\n\n// On every new pulsar cycle: evaluate stochastic masking & alternate pan\nif (new_cycle) {\n    rand_val = abs(noise());\n    h_pulsar_active = rand_val > masking;\n    h_pulse_count += 1;\n}\n\n// Pulsaret phase progress inside the active duty window [0, duty_ratio]\nd_ratio = clamp(duty_ratio, 0.005, 0.999);\nin_pulsaret = phase_f0 < d_ratio;\n\nsig = 0;\nif (in_pulsaret && h_pulsar_active) {\n    // Normalized progress inside the pulsaret: 0.0 to 1.0\n    p_norm = phase_f0 / d_ratio;\n    \n    // Window envelope calculation\n    w = 1.0;\n    if (win_type == 0) {\n        w = 1.0; // Rectangular\n    } else if (win_type == 1) {\n        w = 0.5 * (1.0 - cos(p_norm * TWOPI)); // Hanning\n    } else if (win_type == 2) {\n        // Gaussian approximation\n        xg = (p_norm - 0.5) * 5.0;\n        w = exp(-0.5 * xg * xg);\n    } else {\n        w = exp(-p_norm * 4.0); // Exponential decay\n    }\n    \n    // Internal pulsaret waveform\n    eff_formant = clamp(formant_f + in2, 20, 12000);\n    pulsar_cycles = eff_formant * (d_ratio / max(f0, 0.1));\n    p_wave_phase = wrap(p_norm * pulsar_cycles, 0, 1);\n    \n    osc = 0;\n    if (wave_shape == 0) {\n        osc = sin(p_wave_phase * TWOPI); // Sine\n    } else if (wave_shape == 1) {\n        osc = (abs(p_wave_phase - 0.5) * 4.0) - 1.0; // Triangle\n    } else if (wave_shape == 2) {\n        // Chirp: frequency rises within the pulsaret\n        chirp_ph = p_wave_phase * (1.0 + p_norm * 2.0);\n        osc = sin(wrap(chirp_ph, 0, 1) * TWOPI);\n    } else {\n        // Harmonics\n        osc = (sin(p_wave_phase * TWOPI) * 0.7) + (sin(p_wave_phase * 4.0 * PI) * 0.3);\n    }\n    \n    sig = osc * w;\n}\n\n// Alternating pan positioning per pulsar pulse\npan_dir = (h_pulse_count % 2) ? 1.0 : -1.0;\npan_pos = 0.5 + (pan_dir * pan_spread * 0.45);\npan_L = cos(pan_pos * HALFPI);\npan_R = sin(pan_pos * HALFPI);\n\nout1 = sig * pan_L;\nout2 = sig * pan_R;\n"
                }
            },
