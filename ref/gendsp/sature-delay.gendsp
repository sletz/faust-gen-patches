        "bottomtoolbarpinned": 2,
        "boxes": [
            {
                "box": {
                    "code": "/**\n * ============================================================================\n * @file sature-delay.gendsp / sature-delay.maxpat\n * @title SATURE-DELAY (Master Character Lo-Fi & Dying-Battery Analog Delay)\n * @author Max Bruckert (assisted by Gemini)\n *\n * @description\n * Full-featured stereo character delay processor with dual degradation engines:\n *   - Wow & Flutter micro-pitch instability (+ battery clock droop in Mode 1)\n *   - Digital Mode (mode = 0): Logarithmic bitcrusher & sample rate reduction\n *   - Battery Mode (mode = 1): Gain-calibrated dying 9V battery simulation\n *     with asymmetric RC supply sag, Class-A bias collapse, and velcro gate\n *   - 40 Hz DC cleanup highpass filter\n *   - True Musical Tilt EQ (+/-18 dB asymmetric cut/boost around hinge freq)\n *   - Allpass diffusion smearing echoes into reverberant clouds\n *   - Soft-ceiling feedback AGC locking high feedback at edge of self-oscillation\n *   - True Ping-Pong stereo bounce (mono sum -> L -> R -> L -> R)\n *\n * @inlets\n *   in1 : Audio Left Input\n *   in2 : Audio Right Input\n *\n * @outlets\n *   out1 : Processed Audio Left\n *   out2 : Processed Audio Right\n *\n * @parameters\n *   time     (1..2000 ms, def: 250)     : Delay time with smooth slide interpolation\n *   fb       (0..1.2, def: 0.5)         : Feedback level (auto-limited at oscillation edge)\n *   tilt     (-1..1, def: 0)            : Spectral tilt (-1: Dark Bass / +1: Bright Treble)\n *   freq     (40..15000 Hz, def: 1000)  : True 2*pi hinge cutoff frequency for Tilt EQ\n *   diff     (0..1, def: 0)             : Allpass diffusion smearing (0: Crisp, 1: Cloud)\n *   crush    (0..1, def: 0)             : Degradation (Bitcrush in Mode 0, Battery death in Mode 1)\n *   mode     (0..1, def: 0)             : Engine selector (0: Digital Lo-Fi, 1: Dying Battery)\n *   pingpong (0..1, def: 0)             : 0: Dual Mono, 1: True Ping-Pong (L <-> R)\n *   mix_bal  (0..1, def: 0.5)           : Dry / Wet balance\n * ============================================================================\n */\n// 1. PROCESSING FUNCTIONS\n// -----------------------------------------------------------------------------\n\n// DC Blocker (5 Hz highpass filter to remove DC offset)\ndcblock_clean(sig, p_in, p_out) {\n    y_dc = sig - p_in + (0.9997 * p_out);\n    return y_dc, sig, y_dc;\n}\n\n// Filtre Passe-Haut 40Hz (2\u00e8me ordre Butterworth, forme directe transpos\u00e9e II)\nhpf40_clean(sig, s1, s2) {\n    f_hpf = 40 / samplerate;\n    r_hpf = 0.707;\n    c_hpf = tan(3.14159 * f_hpf);\n    a1_h = 1 / (1 + r_hpf*c_hpf + c_hpf*c_hpf);\n    a2_h = -2 * a1_h;\n    a3_h = a1_h;\n    b1_h = 2 * a1_h * (c_hpf*c_hpf - 1);\n    b2_h = a1_h * (1 - r_hpf*c_hpf + c_hpf*c_hpf);\n    y_hpf = a1_h * sig + s1;\n    new_s1 = a2_h * sig - b1_h * y_hpf + s2;\n    new_s2 = a3_h * sig - b2_h * y_hpf;\n    return y_hpf, new_s1, new_s2;\n}\n\n// Vrai Tilt EQ autour de f_hinge (pivot exact 2*pi*f/fs, coupe nette -18dB du c\u00f4t\u00e9 oppos\u00e9)\ntilt_process(sig, t_val, f_hinge, h_lp) {\n    f_hz = clamp(f_hinge, 40.0, 18000.0);\n    f_norm = clamp(1.0 - exp(-twopi * f_hz / samplerate), 0.002, 0.92);\n    lows = mix(h_lp, sig, f_norm);\n    highs = sig - lows;\n\n    t_c = clamp(t_val, -1.0, 1.0);\n    g_low  = (t_c >= 0.0) ? mix(1.0, 0.10, t_c) : mix(1.0, 1.30, -t_c);\n    g_high = (t_c >= 0.0) ? mix(1.0, 1.30, t_c) : mix(1.0, 0.10, -t_c);\n\n    y_tilt = (lows * g_low) + (highs * g_high);\n    return y_tilt, lows;\n}\n\n// Mode Digital : Bitcrush + SRR (calibr\u00e9 proche du gain unitaire)\ndigital_fx(sigL, sigR, amt, count, hL, hR) {\n    c_log = 1 - pow(1 - amt, 3);\n    period = floor(mix(1, 32, pow(c_log, 2)));\n    cnt = count + 1;\n    newL = hL; newR = hR;\n    if (cnt >= period) { newL = sigL; newR = sigR; cnt = 0; }\n    st = pow(2, mix(24, 4.5, c_log));\n    yL = (floor(abs(newL) * st + 0.5) / st) * sign(newL);\n    yR = (floor(abs(newR) * st + 0.5) / st) * sign(newR);\n    return yL * 0.98, yR * 0.98, cnt, newL, newR;\n}\n\n// Etage transistor sous-aliment\u00e9 par canal (pile mourante, gain calibr\u00e9 sur Mode 0)\nbattery_stage(x, amt, v_sag, thresh, crackle) {\n    res = x * 0.98;\n    if (amt > 0.0001) {\n        ax = abs(x);\n        gate_w = max(0.002, amt * 0.020);\n        cond_raw = clamp((ax + crackle - thresh) / gate_w, 0.0, 1.0);\n        // Smoothstep velcro gate: coupe et cr\u00e9pite sur les queues de note\n        cond = cond_raw * cond_raw * (3.0 - 2.0 * cond_raw);\n\n        // Chute asym\u00e9trique des rails d alimentation (+/-)\n        rail_pos = max(0.20, v_sag);\n        rail_neg = max(0.10, v_sag * 0.48);\n        bias_shift = amt * 0.14 * rail_pos;\n        driven = x * (1.0 + amt * 1.4) + bias_shift;\n\n        sat = (driven >= 0.0) ? (rail_pos * tanh(driven / rail_pos)) : (rail_neg * tanh(driven / rail_neg));\n        dc_bias = rail_pos * tanh(bias_shift / rail_pos);\n\n        // Trim calibr\u00e9 : conserve le grain et la compression sans explosion de gain vs Mode 0\n        trim = 0.98 / (1.0 + amt * 0.45);\n        y = (sat - dc_bias) * cond * trim;\n        res = clamp(y, -0.85, 0.85);\n    }\n    return res;\n}\n\n// Battery Mode: Dynamic RC supply sag + velcro bias gate + dark clock droop\nanalog_fx(sigL, sigR, amt, h_sag, h_lpfL, h_lpfR, h_noise) {\n    draw = max(abs(sigL), abs(sigR));\n    v_nom = mix(1.0, 0.28, pow(amt, 0.85));\n    v_target = max(0.12, v_nom / (1.0 + draw * amt * 3.5));\n    rc_coeff = (v_target < h_sag) ? (1.0 - exp(-1.0 / (0.002 * samplerate))) : (1.0 - exp(-1.0 / (0.120 * samplerate)));\n    new_sag = h_sag + rc_coeff * (v_target - h_sag);\n\n    presence = min(1.0, draw * 50.0);\n    new_noise = mix(h_noise, noise(), 0.35);\n    crackle = new_noise * pow(amt, 1.4) * 0.012 * presence;\n    thresh = pow(amt, 1.6) * 0.030 * (1.2 - new_sag);\n\n    yL = battery_stage(sigL, amt, new_sag, thresh, crackle);\n    yR = battery_stage(sigR, amt, new_sag, thresh, crackle);\n\n    lp_cut = clamp(0.45 + new_sag * 0.55, 0.45, 1.0);\n    fL = mix(h_lpfL, yL, lp_cut);\n    fR = mix(h_lpfR, yR, lp_cut);\n\n    return fL, fR, new_sag, fL, fR, new_noise;\n}\n\n// Allpass (Diffusion)\nallpass_fx(sig, g, dly, sz_ms) {\n    s_read = dly.read(mstosamps(sz_ms));\n    v_ap = sig - (s_read * g);\n    dly.write(v_ap);\n    return s_read + (v_ap * g);\n}\n\n// 2. PARAM\u00c8TRES ET M\u00c9MOIRE\n// -----------------------------------------------------------------------------\nParam time(250, min=1, max=2000);\nParam fb(0.5, min=0, max=1.2);\nParam tilt(0, min=-1, max=1);\nParam freq(1000, min=40, max=15000);\nParam diff(0, min=0, max=1);\nParam crush(0, min=0, max=1);\nParam mode(0, min=0, max=1);\nParam pingpong(0, min=0, max=1);\nParam mix_bal(0.5, min=0, max=1);\n\nDelay delayL(samplerate * 2), delayR(samplerate * 2);\nDelay apL1(16000), apL2(16000), apR1(16000), apR2(16000);\n\nHistory h_smTime(0), h_tL(0), h_tR(0), h_noise(0);\nHistory h_sag(1.0), h_batLpL(0), h_batLpR(0), h_fb_env(0);\nHistory h_hL1(0), h_hL2(0), h_hR1(0), h_hR2(0);\nHistory h_dcLi(0), h_dcLo(0), h_dcRi(0), h_dcRo(0);\nHistory h_cnt(0), h_hL(0), h_hR(0);\n\n// 3. MAIN DSP LOGIC\n// -----------------------------------------------------------------------------\n\nv_degL = 0; v_degR = 0;\nv_feedL = 0; v_feedR = 0;\n\n// Temps de d\u00e9lai (Slide + micro-jitter + l\u00e9ger droop d horloge en mode Battery)\nsag_droop = (mode >= 0.5) ? (1.0 - h_sag) * crush * 35.0 : 0.0;\nh_smTime = slide(mstosamps(time) + (noise() * 0.35) + sag_droop, 15000, 15000);\n\n// Read delay taps\nv_tapL = delayL.read(h_smTime, interp=\"cubic\");\nv_tapR = delayR.read(h_smTime, interp=\"cubic\");\n\n// --- FEEDBACK CHAIN (Cumulative) ---\n\n// 1. DEGRADATION\nif (mode < 0.5) {\n    v_degL, v_degR, h_cnt, h_hL, h_hR = digital_fx(v_tapL, v_tapR, crush, h_cnt, h_hL, h_hR);\n    h_sag = h_sag + 0.001 * (1.0 - h_sag);\n} else {\n    v_degL, v_degR, h_sag, h_batLpL, h_batLpR, h_noise = analog_fx(v_tapL, v_tapR, crush, h_sag, h_batLpL, h_batLpR, h_noise);\n}\n\n// 2. S\u00c9CURIT\u00c9 : HPF 40Hz\nv_hpL, h_hL1, h_hL2 = hpf40_clean(v_degL, h_hL1, h_hL2);\nv_hpR, h_hR1, h_hR2 = hpf40_clean(v_degR, h_hR1, h_hR2);\n\n// 3. TILT EQ (Vrai pivot fr\u00e9quentiel autour de freq)\nv_tiL, h_tL = tilt_process(v_hpL, tilt, freq, h_tL);\nv_tiR, h_tR = tilt_process(v_hpR, tilt, freq, h_tR);\n\n// 4. DIFFUSION\ndiff_c = clamp(diff, 0.0, 1.0);\nv_dg = diff_c * 0.82;\nv_dfL = allpass_fx(allpass_fx(v_tiL, v_dg, apL1, 23), v_dg, apL2, 51);\nv_dfR = allpass_fx(allpass_fx(v_tiR, v_dg, apR1, 29), v_dg, apR2, 57);\nv_procL = mix(v_tiL, v_dfL, diff_c);\nv_procR = mix(v_tiR, v_dfR, diff_c);\n\n// 5. S\u00c9CURIT\u00c9 : DC BLOCK & SOFT LIMITER\nv_cleanL, h_dcLi, h_dcLo = dcblock_clean(v_procL, h_dcLi, h_dcLo);\nv_cleanR, h_dcRi, h_dcRo = dcblock_clean(v_procR, h_dcRi, h_dcRo);\n\nv_finalL = clamp(tanh(v_cleanL), -1, 1);\nv_finalR = clamp(tanh(v_cleanR), -1, 1);\n\n// 6. FEEDBACK ROUTING & AUTO-OSCILLATION SOFT LIMITER\n// Limite dynamiquement le feedback au-del\u00e0 d un seuil d \u00e9nergie pour rester\n// exactement \u00e0 la fronti\u00e8re de l auto-oscillation sans emballement brutal.\npeak_env = max(abs(v_finalL), abs(v_finalR));\nh_fb_env = h_fb_env + 0.005 * (peak_env - h_fb_env);\nfb_raw = clamp(fb, 0.0, 1.2) * 1.04;\nagc_duck = 1.0 / (1.0 + max(0.0, h_fb_env - 0.35) * 1.6);\nv_fb_eff = min(1.04, fb_raw * agc_duck);\n\npp = clamp(pingpong, 0.0, 1.0);\npp_in = (in1 + in2) * 0.5;\n\nv_feedL = mix(in1, pp_in, pp) + mix(v_finalL, v_finalR, pp) * v_fb_eff;\nv_feedR = mix(in2, 0.0, pp)   + mix(v_finalR, v_finalL, pp) * v_fb_eff;\n\ndelayL.write(fixdenorm(v_feedL));\ndelayR.write(fixdenorm(v_feedR));\n\n// --- OUTPUT STAGE ---\nout1 = mix(in1, v_finalL, clamp(mix_bal, 0.0, 1.0));\nout2 = mix(in2, v_finalR, clamp(mix_bal, 0.0, 1.0));",
                    "fontface": 0,
                    "fontname": "<Monospaced>",
                    "fontsize": 12.0,
