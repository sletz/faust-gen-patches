                    "patching_rect": [
                        40.0,
                        60.0,
                        750.0,
                        650.0
                    ],
                    "code": "/**\n * ============================================================================\n * @file householder-fdn-16.gendsp / householder-fdn-16.maxpat\n * @title 16x16 HOUSEHOLDER MATRIX SPATIAL FDN REVERB\n * @author Max Bruckert (assisted by Gemini)\n *\n * @description\n * Ultra-dense 16-channel Feedback Delay Network reverberator. Employs an exact\n * orthogonal Householder reflection matrix H = I - (2/N)*1*1^T computed in O(N)\n * time complexity (16 subtractions, 1 global sum) guaranteeing absolute energy\n * preservation and unconditional stability.\n *\n * @inlets\n *   in1 : Audio Left Input\n *   in2 : Audio Right Input\n *\n * @outlets\n *   out1 : Reverb Wet Left\n *   out2 : Reverb Wet Right\n * ============================================================================\n */\n\nParam size(1.0, min=0.1, max=2.0);\nParam decay(4.5, min=0.1, max=30);\nParam damping(0.35, min=0, max=1);\nParam mod_amt(3.0, min=0, max=20);\nParam mod_rate(0.7, min=0.1, max=5);\nParam mix(50, min=0, max=100);\n\n// 16 Mutually prime delay line memories (scaled ~480 to 4500 samples)\nDelay d0(16000), d1(16000), d2(16000), d3(16000);\nDelay d4(16000), d5(16000), d6(16000), d7(16000);\nDelay d8(16000), d9(16000), d10(16000), d11(16000);\nDelay d12(16000), d13(16000), d14(16000), d15(16000);\n\n// 16 1-pole absorption filter memories\nHistory h0(0), h1(0), h2(0), h3(0);\nHistory h4(0), h5(0), h6(0), h7(0);\nHistory h8(0), h9(0), h10(0), h11(0);\nHistory h12(0), h13(0), h14(0), h15(0);\n\n// Modulation LFO phase\nHistory h_lfo_ph(0);\nh_lfo_ph = wrap(h_lfo_ph + (mod_rate / samplerate), 0, 1);\nlfo_sin = sin(h_lfo_ph * TWOPI) * mod_amt;\nlfo_cos = cos(h_lfo_ph * TWOPI) * mod_amt;\n\n// Base prime lengths\nsz = clamp(size, 0.1, 2.5);\nlen0 = clamp(509 * sz + lfo_sin, 10, 15000);\nlen1 = clamp(631 * sz - lfo_cos, 10, 15000);\nlen2 = clamp(769 * sz + lfo_cos, 10, 15000);\nlen3 = clamp(919 * sz - lfo_sin, 10, 15000);\nlen4 = clamp(1087 * sz + lfo_sin * 0.7, 10, 15000);\nlen5 = clamp(1277 * sz - lfo_cos * 0.7, 10, 15000);\nlen6 = clamp(1487 * sz + lfo_cos * 0.8, 10, 15000);\nlen7 = clamp(1709 * sz - lfo_sin * 0.8, 10, 15000);\nlen8 = clamp(1973 * sz + lfo_sin * 0.9, 10, 15000);\nlen9 = clamp(2251 * sz - lfo_cos * 0.9, 10, 15000);\nlen10 = clamp(2557 * sz + lfo_cos, 10, 15000);\nlen11 = clamp(2879 * sz - lfo_sin, 10, 15000);\nlen12 = clamp(3221 * sz + lfo_sin * 1.1, 10, 15000);\nlen13 = clamp(3593 * sz - lfo_cos * 1.1, 10, 15000);\nlen14 = clamp(3989 * sz + lfo_cos * 1.2, 10, 15000);\nlen15 = clamp(4409 * sz - lfo_sin * 1.2, 10, 15000);\n\n// Read from delay lines\nt0 = d0.read(len0); t1 = d1.read(len1); t2 = d2.read(len2); t3 = d3.read(len3);\nt4 = d4.read(len4); t5 = d5.read(len5); t6 = d6.read(len6); t7 = d7.read(len7);\nt8 = d8.read(len8); t9 = d9.read(len9); t10 = d10.read(len10); t11 = d11.read(len11);\nt12 = d12.read(len12); t13 = d13.read(len13); t14 = d14.read(len14); t15 = d15.read(len15);\n\n// 1-Pole Lowpass damping per line\nd_alpha = clamp(damping * 0.7, 0, 0.95);\nt0 = t0 * (1 - d_alpha) + h0 * d_alpha; h0 = t0;\nt1 = t1 * (1 - d_alpha) + h1 * d_alpha; h1 = t1;\nt2 = t2 * (1 - d_alpha) + h2 * d_alpha; h2 = t2;\nt3 = t3 * (1 - d_alpha) + h3 * d_alpha; h3 = t3;\nt4 = t4 * (1 - d_alpha) + h4 * d_alpha; h4 = t4;\nt5 = t5 * (1 - d_alpha) + h5 * d_alpha; h5 = t5;\nt6 = t6 * (1 - d_alpha) + h6 * d_alpha; h6 = t6;\nt7 = t7 * (1 - d_alpha) + h7 * d_alpha; h7 = t7;\nt8 = t8 * (1 - d_alpha) + h8 * d_alpha; h8 = t8;\nt9 = t9 * (1 - d_alpha) + h9 * d_alpha; h9 = t9;\nt10 = t10 * (1 - d_alpha) + h10 * d_alpha; h10 = t10;\nt11 = t11 * (1 - d_alpha) + h11 * d_alpha; h11 = t11;\nt12 = t12 * (1 - d_alpha) + h12 * d_alpha; h12 = t12;\nt13 = t13 * (1 - d_alpha) + h13 * d_alpha; h13 = t13;\nt14 = t14 * (1 - d_alpha) + h14 * d_alpha; h14 = t14;\nt15 = t15 * (1 - d_alpha) + h15 * d_alpha; h15 = t15;\n\n// Decay feedback factor (True uniform T60 decay per line)\nt60_samps = max(decay, 0.1) * samplerate;\nalpha_t60 = -6.907755278982137 / t60_samps;\n\ng0 = exp(alpha_t60 * len0);\ng1 = exp(alpha_t60 * len1);\ng2 = exp(alpha_t60 * len2);\ng3 = exp(alpha_t60 * len3);\ng4 = exp(alpha_t60 * len4);\ng5 = exp(alpha_t60 * len5);\ng6 = exp(alpha_t60 * len6);\ng7 = exp(alpha_t60 * len7);\ng8 = exp(alpha_t60 * len8);\ng9 = exp(alpha_t60 * len9);\ng10 = exp(alpha_t60 * len10);\ng11 = exp(alpha_t60 * len11);\ng12 = exp(alpha_t60 * len12);\ng13 = exp(alpha_t60 * len13);\ng14 = exp(alpha_t60 * len14);\ng15 = exp(alpha_t60 * len15);\n\n// --- HOUSEHOLDER 16x16 TRANSFORMATION ---\n// Sum all 16 taps: s = sum(x_k)\nsum16 = t0 + t1 + t2 + t3 + t4 + t5 + t6 + t7 + t8 + t9 + t10 + t11 + t12 + t13 + t14 + t15;\nscale_sum = sum16 * (2.0 / 16.0); // 0.125 * sum\n\n// Injected inputs (distributed with alternating signs across 16 lines)\ninL = in1 * 0.25;\ninR = in2 * 0.25;\n\nd0.write(tanh((t0 - scale_sum + inL) * g0));\nd1.write(tanh((t1 - scale_sum + inR) * g1));\nd2.write(tanh((t2 - scale_sum - inL) * g2));\nd3.write(tanh((t3 - scale_sum - inR) * g3));\nd4.write(tanh((t4 - scale_sum + inL) * g4));\nd5.write(tanh((t5 - scale_sum + inR) * g5));\nd6.write(tanh((t6 - scale_sum - inL) * g6));\nd7.write(tanh((t7 - scale_sum - inR) * g7));\nd8.write(tanh((t8 - scale_sum + inL) * g8));\nd9.write(tanh((t9 - scale_sum + inR) * g9));\nd10.write(tanh((t10 - scale_sum - inL) * g10));\nd11.write(tanh((t11 - scale_sum - inR) * g11));\nd12.write(tanh((t12 - scale_sum + inL) * g12));\nd13.write(tanh((t13 - scale_sum + inR) * g13));\nd14.write(tanh((t14 - scale_sum - inL) * g14));\nd15.write(tanh((t15 - scale_sum - inR) * g15));\n\n// Spatial stereo output tap decorellation\nwetL = (t0 - t2 + t4 - t6 + t8 - t10 + t12 - t14) * 0.35;\nwetR = (t1 - t3 + t5 - t7 + t9 - t11 + t13 - t15) * 0.35;\n\n// Dry / Wet balance\nbal = mix * 0.01;\nout1 = (in1 * (1.0 - bal)) + (wetL * bal);\nout2 = (in2 * (1.0 - bal)) + (wetR * bal);\n"
                }
            },
