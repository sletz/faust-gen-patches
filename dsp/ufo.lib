// The UFO multi-LFO of GEN-patches (gendsp/ufo.gendsp, ufo-core.gendsp,
// ufo-core-simple.gendsp), original LFO by Dric, rampsmooth codebox by
// Maurizio Giri, modified by Max Bruckert.
//
// The three patches compute the same thing at different depths:
//
//   ufo-core-simple   the phase core only: an accum of f/SR, reset by a rising
//                     edge of the trigger input, free running or clipped to
//                     `shotnumbers` cycles (one-shot), wrapped, multiplied by
//                     `expc`, raised to `exp1`; output pow*2-1 (not wrapped).
//   ufo               the phase core, wrapped once more, into six waveforms
//                     (a nested gen: cos, triangle, saw, square, sample and
//                     hold of noise, the S&H through rampsmooth), then
//                     pow(x*0.5+0.5, exp2)*2-1, gain, offset, clip, invert,
//                     unipolar.
//   ufo-core          ufo flattened for RNBO (no nested gen), each parameter
//                     summed with a signal inlet (in + param): with those
//                     inlets at zero it is ufo, bit for bit.
//
// The arithmetic is the export's (ref/export/ufo*.cpp): genlib's clamp as
// nested ternaries, selector choices by int truncation, safediv/safepow.

declare name "ufo";
declare license "MIT";

ma = library("maths.lib");
si = library("signals.lib");
g = library("genops.lib");

// genlib's `clip`/`clamp` as the export writes it inline:
// x <= lo ? lo : (x >= hi ? hi : x). Unlike g.clamp (min(max(x, lo), hi)) it
// returns lo, not hi, when hi < lo and x <= lo (ufo-core: shotnumbers summed
// with a negative inlet) and lets a NaN through.
clip = g.clip;

// the sample rate as a signal Faust cannot fold: Faust rewrites x/SR as
// x*(1/SR), one rounding off genlib's safediv(f, samplerate) and so 1 ulp off
// the phase increment for some frequencies (-319 dB in the tests); dividing
// by this recursive copy keeps a true division.
sr = max(ma.SR) ~ _;

// gen's `selector N` on choice int(c): 0 below 1, input k for k <= c < k+1,
// the last one above
_sel2(c, a, b) = select2(k >= 2, select2(k >= 1, 0, a), b) with { k = int(c); };
_sel6(c, a, b, cc, d, e, f) = select2(k >= 6, select2(k >= 5, select2(k >= 4,
    select2(k >= 3, select2(k >= 2, select2(k >= 1, 0, a), b), cc), d), e), f)
with { k = int(c); };

// the frequency inlet as the patch reads it: clip 0.0001..1000 Hz
freq(f) = clip(0.0001, 1000, f);

// the phase core, up to the pow (ufo-core-simple outputs pow*2-1, ufo wraps it)
//   fc: clipped frequency, trig: trigger inlet (rising edge of > 0.5 resets the
//   accum), exp1, expc, oneshot (int(oneshot+1) >= 2: one-shot), shot: the
//   number of cycles of the one-shot. The one-shot phase is wrap(-x): it runs
//   from 1 down to 0, `shot` times, then holds wrap(-shot).
phase(fc, trig, exp1, expc, oneshot, shot) = g.safepow(w * expc, exp1)
with {
    t = trig > 0.5;
    rst = clip(0, 1, t - t');
    acc = g.accum(g.safediv(fc, sr), rst);
    s = _sel2(oneshot + 1, acc, 0 - clip(0, shot, acc));
    w = g.wrap(0, 1, s);
};

// rampsmooth (Maurizio Giri's codebox): a linear ramp of `rampup`/`rampdown`
// samples toward each new value of insig. The codebox's test
//   delta(insig) == 0 && delta(rampup) == 0 && delta(rampdown) == 0
// is compiled with C's short circuit: delta(rampup) only updates its history
// on frames where insig did not move, delta(rampdown) only where neither
// did. Reproduced: hru, hrd are those histories.
rampsmooth(insig, ru0, rd0) = loop ~ si.bus(6) : (_, !, !, !, !, !)
with {
    ru = select2(ru0 < 1, ru0, 1);
    rd = select2(rd0 < 1, rd0, 1);
    loop(last, dir, sc, inc, hru, hrd) = out, dir2, sc2, inc2, hru2, hrd2
    with {
        c1 = (insig - insig') == 0;
        c2 = c1 & ((ru - hru) == 0);
        c3 = c2 & ((rd - hrd) == 0);
        hru2 = select2(c1, hru, ru);
        hrd2 = select2(c2, hrd, rd);
        // nothing moved: go on with the ramp, or land on insig
        adv = sc < select2(dir > 0, rd, ru);
        outA = select2(adv, insig, last + inc);
        scA = select2(adv, sc, sc + 1);
        // something moved: a new ramp from the last output
        dv = insig - last;
        up = dv > 0;
        incB = select2(up, g.safediv(dv, rd), g.safediv(dv, ru));
        out = select2(c3, last + incB, outA);
        sc2 = select2(c3, 1, scA);
        dir2 = select2(c3, select2(up, -1, 1), dir);
        inc2 = select2(c3, incB, inc);
    };
};

// the six waveforms on phase ph (in [0, 1)), selected by int(lfosel+1):
// 1 cos, 2 triangle, 3 saw, 4 square, 5 S&H of nz on each upward crossing of
// 0.5 by the phase, 6 that S&H through rampsmooth over one period
// (SR/fc samples); 0 below. nz: gen's noise(), drawn every frame.
lfo(fc, ph, lfosel, nz) = _sel6(lfosel + 1, co, tri, saw, sq, sh, rs)
with {
    pw = g.wrap(0, 1, ph);
    saw = pw * 2 - 1;
    tri = g.triangle(ph, 0.5) * 2 - 1;
    sh = g.sah(nz, pw, 0.5);
    r = g.safediv(ma.SR, select2(fc < 0.0001, fc, 0.0001));
    rs = rampsmooth(sh, r, r);
    sq = (pw < 0.5) * 2 - 1;
    co = cos(ph * 6.2831853071795862);
};

// the output stage: curvature exp2, gain, offset (percent, subtracted),
// clip -1..1, invert (int(invert+1) >= 2), unipolar (int(unipolar+1) >= 2)
output(exp2, gain, offset, invert, unipolar, x) = _sel2(unipolar + 1, sv, sv * 0.5 + 0.5)
with {
    b = g.safepow(x * 0.5 + 0.5, exp2) * 2 - 1;
    c = clip(-1, 1, b * gain + (0 - offset * 0.01));
    sv = _sel2(invert + 1, c, 0 - c);
};

// the whole LFO (ufo, ufo-core): the parameters as the patch sums them
ufo(f, trig, lfosel, exp1, expc, exp2, oneshot, shot, gain, offset, invert, unipolar, nz) =
    output(exp2, gain, offset, invert, unipolar, lfo(fc, ph, lfosel, nz))
with {
    fc = freq(f);
    ph = g.wrap(0, 1, phase(fc, trig, exp1, expc, oneshot, shot));
};

// ufo-core-simple: the phase core, bipolar
core(f, trig, exp1, expc, oneshot, shot) = phase(freq(f), trig, exp1, expc, oneshot, shot) * 2 - 1;
