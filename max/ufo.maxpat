            {
                "box": {
                    "id": "obj-1",
                    "maxclass": "newobj",
                    "numinlets": 2,
                    "numoutlets": 3,
                    "patching_rect": [
                        485.0,
                        696.0,
                        556.0,
                        22.0
                    ],
                    "outlettype": [
                        "signal",
                        "",
                        ""
                    ],
                    "text": "faustgen~",
                    "sourcecode": "// ufo: Faust port of the gen~ patch of GEN-patches (Max Bruckert),\n// generated from faust-gen-patches/dsp/ufo.dsp by max/convert_patches.py;\n// edit that file and regenerate. Its libraries are embedded as environments.\n// UFO: multi-waveform LFO with curvature shaping and rampsmooth (gen~: gendsp/ufo.gendsp)\n//\n// Original LFO by Dric, rampsmooth codebox by Maurizio Giri, modified by Max\n// Bruckert; one codebox in the gendsp.\n//\n// A phase accumulator (frequency from in1, clipped to 0.0001..1000 Hz) reset\n// to 0 by a rising edge of in2 through 0.5, free running or limited to\n// `shotnumbers` cycles in one-shot mode, wrapped, multiplied by `expc`\n// (2: two cycles per period), raised to `exp1`, wrapped again, then read by\n// one of six waveforms (`lfosel`): 0 cosine, 1 triangle, 2 saw, 3 square,\n// 4 sample and hold of noise (a new value when the phase crosses 0.5 upward),\n// 5 that S&H through a linear rampsmooth over one period (SR/fc samples).\n// The output stage maps to 0..1 (clipped), raises to `exp2`, back to -1..1,\n// scales by `gain`, subtracts `offset` percent, clips to -1..1, then\n// optionally inverts and maps to 0..1 (`unipolar`).\n//\n// in1: frequency in Hz (0.0001..1000)    in2: trigger (reset / restart in one-shot)\n// out1: the LFO (bipolar, or unipolar)\n//\n// Parameters: lfosel (0..5, def 0), exp1 (0.05..20, def 1), expc (0..8,\n// def 1), exp2 (0.05..20, def 1), oneshot (0/1), shotnumbers (0..128, def 1),\n// gain (0..10, def 1), offset (-100..100 %, def 0), invert (0/1),\n// unipolar (0/1). The switches and lfosel are compared to x.5 thresholds.\n//\n// Quirks kept from gen~:\n// - the one-shot phase is wrap(0 - clamp(acc, 0, shotnumbers)): it runs from\n//   1 down to 0, `shotnumbers` times, then holds;\n// - the accumulator is never wrapped: in single precision the period is\n//   1 % long after 10 s at 3.7 Hz;\n// - rampsmooth's test `delta(sh) == 0 && delta(rampup) == 0 &&\n//   delta(rampdown) == 0` short-circuits, so the second and third delta update\n//   their history only on some frames, and a frequency change restarts the\n//   ramp twice.\n\ndeclare name \"ufo\";\ndeclare author \"Max Bruckert, after Dric and Maurizio Giri (gen~), Faust port\";\ndeclare license \"MIT\";\n\nma = library(\"maths.lib\");\nsi = library(\"signals.lib\");\ng = environment {\n//##############################################################################\n// genops.lib: the gen~ operators (genlib, Max 9.2.1) in Faust\n//\n// Each function reproduces the arithmetic of its genlib counterpart\n// (ref/export/gen_dsp/genlib_ops.h), operation for operation, so that a port\n// written with them agrees with the gen~ export to the last bits wherever the\n// math library does. Conventions: arguments in genlib's order, signal last\n// (`wrap(lo, hi, v)`, `clamp(lo, hi, x)`) so that they compose as Faust\n// processors (`_ : wrap(0, 1)`).\n//\n// MIT License, as GEN-patches.\n//##############################################################################\n\ndeclare name \"genops\";\ndeclare version \"1.0.0\";\ndeclare license \"MIT\";\n\nma = library(\"maths.lib\");\nba = library(\"basics.lib\");\nde = library(\"delays.lib\");\nsi = library(\"signals.lib\");\n\n//---------------------------------------------------------------- scalars\n\n// trunc toward zero without going through a 32-bit int: (int64_t)x in genlib\ntrunc(x) = select2(x < 0, floor(x), ceil(x));\n\n// genlib minimum/maximum/clamp: clamp(x, lo, hi) = min(max(x, lo), hi)\nclamp(lo, hi, x) = min(max(x, lo), hi);\n\n// the clamp the exports inline for `clip` and Param ranges:\n// x <= lo ? lo : (x >= hi ? hi : x); differs from clamp when hi < lo or x is NaN\nclip(lo, hi, x) = select2(x <= lo, select2(x >= hi, x, hi), lo);\n\n// mix(x, y, a) = x + a*(y - x)\nmix(x, y, a) = x + a * (y - x);\n\n// safediv(num, den) = den == 0 ? 0 : num/den\nsafediv(n, d) = select2(d == 0, n / select2(d == 0, d, 1), 0);\n\n// fixnan: genlib's double test is \"exponent all ones\", so inf goes to 0 too\nfixnan(v) = select2((v - v) != (v - v), v, 0);\n\n// safepow(b, e) = fixnan(pow(b, e))\nsafepow(b, e) = fixnan(pow(b, e));\n\n// fixdenorm: a subnormal double becomes 0\nfixdenorm(v) = select2((abs(v) < 2.2250738585072014e-308) & (v != 0), v, 0);\n\n// wrap(v, lo, hi): genlib_ops.h, numWraps computed by int64 truncation\nwrap(lo1, hi1, v) = select2(lo1 == hi1, w, lo1)\nwith {\n    lo = min(lo1, hi1);\n    hi = max(lo1, hi1);\n    range = hi - lo;\n    nw = trunc((v - lo) / range) - (v < lo);\n    r = v - range * nw;\n    r2 = select2(r >= hi, r, r - range);\n    w = select2((v >= lo) & (v < hi), select2(range <= 0.000000001, r2, lo), v);\n};\n\n// fold(v, lo, hi): genlib_ops.h\nfold(lo1, hi1, v) = select2(lo1 == hi1, out, lo1)\nwith {\n    lo = min(lo1, hi1);\n    hi = max(lo1, hi1);\n    range = hi - lo;\n    // v >= hi\n    va = v - range;\n    nwa = select2(va >= hi, 0, trunc((va - lo) / range));\n    ra = va - range * nwa;\n    na = nwa + 1;\n    // v < lo\n    vb = v + range;\n    nwb = select2(vb < lo, 0, trunc((vb - lo) / range) - 1);\n    rb = vb - range * nwb;\n    nb = nwb - 1;\n    hiCase = v >= hi;\n    loCase = v < lo;\n    r = select2(hiCase, select2(loCase, v, rb), ra);\n    n = select2(hiCase, select2(loCase, 0, nb), na);\n    odd = (int(n) % 2) != 0;\n    out = select2(odd, r, hi + lo - r);\n};\n\n// triangle(phase, p1): genlib_ops.h\ntriangle(ph0, p10) = select2(ph < p1, down, up)\nwith {\n    ph = wrap(0, 1, ph0);\n    p1 = clamp(0, 1, p10);\n    up = select2(p1 != 0, 0, ph / select2(p1 != 0, 1, p1));\n    down = select2(p1 == 1, 1 - ((ph - p1) / select2(p1 == 1, 1 - p1, 1)), ph);\n};\n\n// scale(in, inlow, inhigh, outlow, outhigh, power)\nscale(in, il, ih, ol, oh, pw) = v2 * (oh - ol) + ol\nwith {\n    v = (in - il) * safediv(1, ih - il);\n    v2 = select2(v > 0, select2(v < 0, v, 0 - pow(0 - v, pw)), pow(v, pw));\n};\n\nsign(v) = select2(v > 0, select2(v < 0, 0, -1), 1);\nfract(x) = x - trunc(x);\ndbtoa(x) = pow(10, x * 0.05);\natodb(x) = select2(x <= 0, 20 * log10(x), -999);\nmstosamps(ms) = ms * (ma.SR * 0.001);  // as the exports inline it\nmtof(m) = 440 * exp(0.057762265 * (m - 69));\n\n// genlib's interpolators (the delay readers below use them), in genlib's\n// order of operations: every intermediate goes through keep() (below), so\n// that the normalizer neither factors nor folds them (it rewrote\n// x + a*(y - x) and regrouped cubic_interp's coefficient products, a few\n// ulps off genlib's)\nlinear_interp(a, x, y) = x + keep(a * keep(y - x));\ncubic_interp(a, w, x, y, z) = keep(keep(keep(keep(w * fw) + keep(x * fx)) + keep(y * fy)) + keep(z * fz))\nwith {\n    a1 = keep(1 + a); aa = keep(a * a1); b = keep(1 - a); b1 = keep(2 - a); bb = keep(b * b1);\n    fw = keep(keep(-0.1666667 * bb) * a); fx = keep(keep(0.5 * bb) * a1);\n    fy = keep(keep(0.5 * aa) * b1); fz = keep(keep(-0.1666667 * aa) * b);\n};\nspline_interp(a, w, x, y, z) = keep(keep(keep(keep(keep(keep(c3 * a) + c2) * a) + c1) * a) + c0)\nwith {\n    c0 = x;\n    c1 = keep(0.5 * keep(y - w));\n    c2 = keep(keep(keep(keep(w - keep(2.5 * x)) + y) + y) - keep(0.5 * z));\n    c3 = keep(keep(0.5 * keep(z - w)) + keep(1.5 * keep(x - y)));\n};\nspline6_interp(a, y0, y1, y2, y3, y4, y5) = h(h(h(h(h(c5, c4), c3), c2), c1), c0)\nwith {\n    h(p, c) = keep(keep(p * a) + c);\n    m(k, v) = keep(k * v);\n    ym2py2 = keep(y0+y4); ym1py1 = keep(y1+y3); y2mym2 = keep(y4-y0); y1mym1 = keep(y3-y1);\n    sixthym1py1 = m(1/6.0, ym1py1);\n    c0 = keep(keep(m(1/120.0, ym2py2) + m(13/60.0, ym1py1)) + m(11/20.0, y2));\n    c1 = keep(m(1/24.0, y2mym2) + m(5/12.0, y1mym1));\n    c2 = keep(keep(m(1/12.0, ym2py2) + sixthym1py1) - m(1/2.0, y2));\n    c3 = keep(m(1/12.0, y2mym2) - m(1/6.0, y1mym1));\n    c4 = keep(keep(m(1/24.0, ym2py2) - sixthym1py1) + m(1/4.0, y2));\n    c5 = keep(keep(m(1/120.0, keep(y5-y0)) + m(1/24.0, keep(y1-y4))) + m(1/12.0, keep(y3-y2)));\n};\n\n//---------------------------------------------------------------- evaluation order\n\n// The Faust normalizer rewrites arithmetic: x / ma.SR becomes x * (1/SR)\n// (1 ulp off genlib's division for about a quarter of the values), a*x + b*x\n// becomes (a+b)*x, constants are folded across products. Where the port must\n// follow the export's order (a chaotic system, a filter near self-oscillation\n// that amplifies the last bit), these keep it:\n//   divsr(x):   a true division by the sample rate (x finite, |x| < 1e300)\n//   tdiv(n, d): a true division by any d > 0 (gen's safediv(n, d) then):\n//               Faust neither turns n / d into n * (1/d) for a d that only\n//               changes with the controls, nor pulls a constant factor of n\n//               out of the quotient (n finite, |n| < 1e300 * d)\n//   keep(x):    an identity the normalizer does not see through (x finite)\ndivsr(x) = x / max(ma.SR, abs(x) * 1e-300);\ntdiv(n0, d) = n / max(d, abs(n) * 1e-300) with { n = keep(n0); };\nkeep(x) = max(x, -1e308);\n\n//---------------------------------------------------------------- stateful operators\n\n// phasor(freq): phase = wrap(phase + freq*(1/sr), 0, 1), the new phase is output\nphasor(f) = (+(f * (1.0 / ma.SR)) : wrap(0, 1)) ~ _;\n\n// History h(init) read before it is written: x[n-1], and `init` at frame 0\nhist(init, x) = select2(1 - 1', x', init);\n// the same for a value fed back by `~` (already delayed): `init(80)` on it\ninit(v, x) = select2(1 - 1', x, v);\n\n// delta(x) = x - x[n-1] (history starts at 0)\ndelta(x) = x - x';\n\n// dcblock: y = x - x1 + 0.9997*y1\ndcblock(x) = (x - x') : (+ ~ *(0.9997));\n\n// sah(in, trig, thresh): latches `in` when trig crosses thresh upward\nsah(in, trig, thresh) = (\\(out).(select2((trig' <= thresh) & (trig > thresh), out, in))) ~ _;\n\n// slide(x, up, down): y += (x - y) / (x > y ? max(1, |up|) : max(1, |down|)),\n// the state passed through fixdenorm, starting at 0\nslide(up, down, x) = (\\(s).(fixdenorm(s + select2(x > s, idown, iup) * (x - s)))) ~ _\nwith { iup = 1 / max(1, abs(up)); idown = 1 / max(1, abs(down)); };\n\n// accum / plusequals: count = reset ? 0 : count + incr (post)\naccum(incr, reset) = (\\(c).(select2(reset != 0, c + incr, 0))) ~ _;\n\n//---------------------------------------------------------------- Delay\n\n// genlib's Delay: a ring of `size` = next power of two >= max(maxdelay, 2)\n// samples, a read head `reader` that advances once per sample (frame n:\n// n mod size), and readers that clamp the delay to [mind, maxdelay], mind = 1\n// for a read before the write of the frame, 0 after (linear, step), plus 1 for\n// the 4- and 6-point readers. `rd_*(MAXD, maxd, mind, x, d)` reads signal x\n// through that arithmetic: r = size + reader - clamp(d), r1 = int(r),\n// a = r - r1, so the interpolation fraction is the very double genlib computes\n// (r and a go through keep(): the normalizer would otherwise fold the delay\n// into the integer part, size + rd - (d + r1), an ulp off).\n// Signal x is the signal written: x@k is memory[(reader - k) & wrap].\n// MAXD is a compile-time bound of maxdelay (Faust sizes its own line by it).\n//\n// The ring is reproduced too: the 4- and 6-point readers at a delay below 3\n// or 5 samples reach the write head, and genlib reads there slots written\n// `size` samples earlier (memory[reader] before this frame's write holds\n// x@size, memory[reader+1] x@(size-1)), not the latest samples. A slot k\n// samples back (k in mind-size..size) holds x@(((k - mind) mod size) + mind).\n//\n// For a read before the write in a feedback loop, pass the feedback delayed by\n// one (xd = x', the `~` of the loop): the readers `rd_*_fb` read x@k as\n// xd@(k-1), with mind = 1.\n\nnpow2(n) = 2 ^ ceil(log(max(n, 2)) / log(2) - 1e-9);\n_reader(size) = ba.time % int(size);\n_ring(MAXD, size, mind, x, k) = x @ max(0, min(2 * MAXD + 2, ((k - mind + size) % size) + mind));\n\n// step: round to nearest with the extra half\nrd_step(MAXD, maxd, mind, x, d) = _ring(MAXD, size, mind, x, size + rd - int(r))\nwith {\n    size = int(npow2(maxd)); rd = _reader(size);\n    r = keep(float(size + rd) - clamp(mind, maxd, d - 0.5));\n};\n\nrd_linear(MAXD, maxd, mind, x, d) = linear_interp(a, tp(k1), tp(k1 - 1))\nwith {\n    size = int(npow2(maxd)); rd = _reader(size);\n    r = keep(float(size + rd) - clamp(mind, maxd, d));\n    r1 = int(r); a = keep(r - float(r1));\n    k1 = size + rd - r1;\n    tp(k) = _ring(MAXD, size, mind, x, k);\n};\n\n_rd4(MAXD, maxd, mind, x, d, interp) = interp(a, tp(k1), tp(k1 - 1), tp(k1 - 2), tp(k1 - 3))\nwith {\n    size = int(npow2(maxd)); rd = _reader(size);\n    r = keep(float(size + rd) - clamp(1 + mind, maxd, d));\n    r1 = int(r); a = keep(r - float(r1));\n    k1 = size + rd - r1;\n    tp(k) = _ring(MAXD, size, mind, x, k);\n};\nrd_cubic(MAXD, maxd, mind, x, d) = _rd4(MAXD, maxd, mind, x, d, cubic_interp);\nrd_spline(MAXD, maxd, mind, x, d) = _rd4(MAXD, maxd, mind, x, d, spline_interp);\n\nrd_spline6(MAXD, maxd, mind, x, d) = spline6_interp(a, tp(k0), tp(k0 - 1), tp(k0 - 2), tp(k0 - 3), tp(k0 - 4), tp(k0 - 5))\nwith {\n    size = int(npow2(maxd)); rd = _reader(size);\n    r = keep(float(size + rd) - clamp(1 + mind, maxd, d));\n    r0 = int(r); a = keep(r - float(r0));\n    k0 = size + rd - r0;\n    tp(k) = _ring(MAXD, size, mind, x, k);\n};\n\n// x@k = xd@(k-1), the slot k back being x@(((k-1) mod size) + 1)\n_ringfb(MAXD, size, xd, k) = xd @ max(0, min(2 * MAXD + 2, (k - 1 + size) % size));\n\nrd_step_fb(MAXD, maxd, xd, d) = _ringfb(MAXD, size, xd, size + rd - int(r))\nwith {\n    size = int(npow2(maxd)); rd = _reader(size);\n    r = keep(float(size + rd) - clamp(1, maxd, d - 0.5));\n};\nrd_linear_fb(MAXD, maxd, xd, d) = linear_interp(a, tp(k1), tp(k1 - 1))\nwith {\n    size = int(npow2(maxd)); rd = _reader(size);\n    r = keep(float(size + rd) - clamp(1, maxd, d));\n    r1 = int(r); a = keep(r - float(r1));\n    k1 = size + rd - r1;\n    tp(k) = _ringfb(MAXD, size, xd, k);\n};\n_rd4_fb(MAXD, maxd, xd, d, interp) = interp(a, tp(k1), tp(k1 - 1), tp(k1 - 2), tp(k1 - 3))\nwith {\n    size = int(npow2(maxd)); rd = _reader(size);\n    r = keep(float(size + rd) - clamp(2, maxd, d));\n    r1 = int(r); a = keep(r - float(r1));\n    k1 = size + rd - r1;\n    tp(k) = _ringfb(MAXD, size, xd, k);\n};\nrd_cubic_fb(MAXD, maxd, xd, d) = _rd4_fb(MAXD, maxd, xd, d, cubic_interp);\nrd_spline_fb(MAXD, maxd, xd, d) = _rd4_fb(MAXD, maxd, xd, d, spline_interp);\n\n//---------------------------------------------------------------- cycle\n\n// cycle(freq) with no buffer: genlib's SineCycle, a 32-bit phase stepped by\n// (uint32)(int64)(freq * 2^32/sr), read in a 16384-point cosine table with\n// linear interpolation (the table entry recomputed as genlib fills it). The\n// phase is kept as an exact integer in a double. Output: cos, then the phase\n// before the step is not needed: `cycle_phase` gives phase() after the step.\n_u32(x) = fmod(fmod(trunc(x), 4294967296.0) + 4294967296.0, 4294967296.0);\n_cycle_phasei(f) = (\\(p).(fmod(p + _u32(f * (4294967296.0 / ma.SR)), 4294967296.0))) ~ _ : mem;\n_costab(i) = cos(float(i) * ma.PI * 2.0 / 16384.0);\ncycle(f) = linear_interp(frac, _costab(idx), _costab((idx + 1) & 16383))\nwith {\n    p = _cycle_phasei(f);\n    idx = int(floor(p / 262144.0));\n    frac = fmod(p, 262144.0) * 3.81471181759574e-6;\n};\n// phase() read after the call: the phase once stepped, in [0, 1)\ncycle_phase(f) = fmod(_cycle_phasei(f) + _u32(f * (4294967296.0 / ma.SR)), 4294967296.0) * 0.232830643653869629e-9;\n\n//---------------------------------------------------------------- noise\n\n// gen~'s noise() is uniform in [-1, 1) (xoshiro256+ seeded by the clock). The\n// ports take their noises as signals; programs use these: K independent\n// streams, stream k of K.\nnoises(K, k) = no.noises(K, k) with { no = library(\"noises.lib\"); };\n};\n\nlfosel = hslider(\"lfosel [style:menu{'cos':0;'triangle':1;'saw':2;'square':3;'random':4;'random smooth':5}]\", 0, 0, 5, 1);\nexp1 = hslider(\"exp1\", 1, 0.05, 20, 0.01);\nexpc = hslider(\"expc\", 1, 0, 8, 0.01);\nexp2 = hslider(\"exp2\", 1, 0.05, 20, 0.01);\noneshot = hslider(\"oneshot [style:menu{'free':0;'one-shot':1}]\", 0, 0, 1, 1);\nshotnumbers = hslider(\"shotnumbers\", 1, 0, 128, 0.01);\ngain = hslider(\"gain\", 1, 0, 10, 0.01);\noffset = hslider(\"offset [unit:%]\", 0, -100, 100, 0.01);\ninvert = hslider(\"invert [style:menu{'off':0;'on':1}]\", 0, 0, 1, 1);\nunipolar = hslider(\"unipolar [style:menu{'off':0;'on':1}]\", 0, 0, 1, 1);\n\n// genlib's clamp as the export writes it inline: x <= lo ? lo : (x >= hi ? hi : x)\nclip = g.clip;\n\n// the sample rate as a signal Faust cannot fold: Faust rewrites x/SR as\n// x*(1/SR), one rounding off gen's fc / samplerate for some frequencies;\n// dividing by this recursive copy keeps a true division.\nsr = max(ma.SR) ~ _;\n\nTWOPI = 6.2831853071795862;\n\n// rampsmooth: a linear ramp of `ramp` samples (rampup = rampdown) toward each\n// new value of insig. delta(rampup) only updates its history (hru) on frames\n// where insig did not move, delta(rampdown) (hrd) only where neither did.\nrampsmooth(insig, ru, rd) = loop ~ si.bus(6) : (_, !, !, !, !, !)\nwith {\n    loop(last, dir, sc, inc, hru, hrd) = out, dir2, sc2, inc2, hru2, hrd2\n    with {\n        c1 = (insig - insig') == 0;\n        c2 = c1 & ((ru - hru) == 0);\n        c3 = c2 & ((rd - hrd) == 0);\n        hru2 = select2(c1, hru, ru);\n        hrd2 = select2(c2, hrd, rd);\n        // nothing moved: go on with the ramp, or land on insig\n        adv = sc < select2(dir > 0, rd, ru);\n        outA = select2(adv, insig, last + inc);\n        scA = select2(adv, sc, sc + 1);\n        // something moved: a new ramp from the last output\n        dv = insig - last;\n        up = dv > 0;\n        incB = select2(up, g.safediv(dv, rd), g.safediv(dv, ru));\n        out = select2(c3, last + incB, outA);\n        sc2 = select2(c3, 1, scA);\n        dir2 = select2(c3, select2(up, -1, 1), dir);\n        inc2 = select2(c3, incB, inc);\n    };\n};\n\n// nz: gen's noise(), read on the frames where the phase crosses 0.5\nufo(nz, in1, in2) = out1\nwith {\n    fc = clip(0.0001, 1000, in1);\n    trig_high = in2 > 0.5;\n    is_trig = trig_high & (trig_high' == 0);\n    acc = (\\(h).(select2(is_trig, h + g.safediv(fc, sr), 0))) ~ _;\n    raw_acc = select2(oneshot > 0.5, acc, 0 - clip(0, shotnumbers, acc));\n    w_base = g.wrap(0, 1, raw_acc);\n    ph = g.wrap(0, 1, g.safepow(w_base * expc, exp1));\n\n    cos_out = cos(ph * TWOPI);\n    tri_out = select2(ph < 0.5, 3 - ph * 4, ph * 4 - 1);\n    saw_out = ph * 2 - 1;\n    sq_out = select2(ph < 0.5, -1, 1);\n    is_sh_cross = (ph >= 0.5) & (ph' < 0.5);\n    sh_out = (\\(h).(select2(is_sh_cross, h, nz))) ~ _;\n    ramp_samps = max(1, g.safediv(ma.SR, max(fc, 0.0001)));\n    rs_out = rampsmooth(sh_out, ramp_samps, ramp_samps);\n\n    raw_lfo = select2(lfosel < 0.5,\n                select2(lfosel < 1.5,\n                  select2(lfosel < 2.5,\n                    select2(lfosel < 3.5,\n                      select2(lfosel < 4.5, rs_out, sh_out),\n                      sq_out),\n                    saw_out),\n                  tri_out),\n                cos_out);\n    u_norm = clip(0, 1, raw_lfo * 0.5 + 0.5);\n    b_curv = g.safepow(u_norm, exp2) * 2 - 1;\n    b_clipped = clip(-1, 1, (b_curv * gain) - (offset * 0.01));\n    b_inv = select2(invert > 0.5, b_clipped, 0 - b_clipped);\n    out1 = select2(unipolar > 0.5, b_inv, b_inv * 0.5 + 0.5);\n};\n\nprocess(f, trig) = ufo(g.noises(1, 0), f, trig);\n// the port with its noise as an input, for scripts/test_gen.py: in1, in2, noise\ndet(f, trig, nz) = ufo(nz, f, trig);\n",
